<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
  <table name="disclaimers" resource="default" engine="innodb" comment="disclaimers Table">
    <column xsi:type="int" name="disclaimers_id" padding="10" unsigned="true" nullable="false" identity="true" comment="disclaimers Id"/>
    <column xsi:type="varchar" name="attribute_set" nullable="true" length="255" comment="Attribute Set"/>
    <column xsi:type="text" name="disclaimer" nullable="true" comment="Disclaimer"/>
    <column xsi:type="int" name="status" padding="11" unsigned="false" nullable="true" identity="false" comment="Status"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="disclaimers_id"/>
    </constraint>
  </table>
</schema>
