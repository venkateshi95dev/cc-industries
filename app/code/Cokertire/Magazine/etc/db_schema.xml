<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
  <table name="magazine" resource="default" engine="innodb" comment="Magazine Table">
    <column xsi:type="int" name="magazine_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Magazine Id"/>
    <column xsi:type="varchar" name="name" nullable="true" length="255" comment="Name"/>
    <column xsi:type="varchar" name="year" nullable="true" length="255" comment="Year"/>
    <column xsi:type="varchar" name="url" nullable="true" length="255" comment="Url"/>
    <column xsi:type="varchar" name="pages" nullable="true" length="255" comment="Pages"/>
    <column xsi:type="varchar" name="location" nullable="true" length="255" comment="Location"/>
    <column xsi:type="varchar" name="width" nullable="true" length="255" comment="Width"/>
    <column xsi:type="varchar" name="height" nullable="true" length="255" comment="Height"/>
    <column xsi:type="int" name="status" padding="11" unsigned="false" nullable="true" identity="false" comment="Status"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="magazine_id"/>
    </constraint>
  </table>
</schema>
