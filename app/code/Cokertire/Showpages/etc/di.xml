<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../lib/internal/Magento/Framework/ObjectManager/etc/config.xsd">
    <virtualType name="CokerShowpagesGirdFilterPool" type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\FulltextFilter</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="CokerShowpagesGridDataProvider" type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="collection" xsi:type="object" shared="false">Cokertire\Showpages\Model\ResourceModel\Showpages\Collection</argument>
            <argument name="filterPool" xsi:type="object" shared="false">CokerShowpagesGirdFilterPool</argument>
        </arguments>
    </virtualType>
    <type name="Cokertire\Showpages\Model\ResourceModel\Showpages\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">showpages</argument>
            <argument name="eventPrefix" xsi:type="string">coker_showpages_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">coker_showpages_grid_collection</argument>
            <argument name="resourceModel" xsi:type="string">Cokertire\Showpages\Model\ResourceModel\Showpages</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="coker_showpages_listing_data_source" xsi:type="string">Cokertire\Showpages\Model\ResourceModel\Showpages\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

  <type name="Amasty\ShopbySeo\Helper\UrlParser">
    <plugin name="skip_url_parse_from_amasty"  type="Cokertire\Showpages\Plugin\SkipUrlParseFromAmasty"/>
  </type>

</config>
