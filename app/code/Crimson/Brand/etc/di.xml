<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Crimson\Brand\Api\BrandRepositoryInterface" type="Crimson\Brand\Model\BrandRepository"/>
    <preference for="Crimson\Brand\Api\Data\BrandInterface" type="Crimson\Brand\Model\Brand"/>
    <preference for="Crimson\Brand\Api\Data\BrandSearchResultInterface" type="Crimson\Brand\Model\BrandSearchResult"/>
    <virtualType name="CrimsonBrandBrandGridDataProvider" type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="collection" xsi:type="object" shared="false">Crimson\Brand\Model\ResourceModel\Brand\Collection</argument>
            <argument name="filterPool" xsi:type="object" shared="false">BrandGirdFilterPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="BrandGirdFilterPool" type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\FulltextFilter</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Crimson\Brand\Api\BrandRepositoryInterface">
        <plugin name="UpdateProductAttributeAfterDelete" type="Crimson\Brand\Plugin\Crimson\Brand\Api\BrandRepositoryInterface\UpdateProductAttributeAfterDelete" />
    </type>

    <type name="Crimson\Brand\Model\ResourceModel\Brand\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">crimson_brand_brand</argument>
            <argument name="eventPrefix" xsi:type="string">crimson_brand_brand_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">brand_grid_collection</argument>
            <argument name="resourceModel" xsi:type="string">Crimson\Brand\Model\ResourceModel\Brand</argument>
        </arguments>
    </type>
    <virtualType name="CrimsonBrandImageUploader" type="Crimson\Brand\Model\Uploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="const">Crimson\Brand\Model\Uploader::IMAGE_TMP_PATH</argument>
            <argument name="basePath" xsi:type="const">Crimson\Brand\Model\Uploader::IMAGE_PATH</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="png" xsi:type="string">png</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="crimson_brand_brand_listing_data_source" xsi:type="string">Crimson\Brand\Model\ResourceModel\Brand\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="Crimson\Brand\Model\UploaderPool">
        <arguments>
            <argument name="uploaders" xsi:type="array">
                <item name="image" xsi:type="string">CrimsonBrandImageUploader</item>
            </argument>
        </arguments>
    </type>
    <type name="Crimson\Brand\Controller\Adminhtml\Brand\Upload">
        <arguments>
            <argument name="uploader" xsi:type="object">CrimsonBrandImageUploader</argument>
        </arguments>
    </type>
    <type name="Crimson\Brand\Ui\Component\Listing\Column\Thumbnail">
        <arguments>
            <argument name="imageModel" xsi:type="object">CrimsonBrandImageUploader</argument>
        </arguments>
    </type>
    <virtualType name="Crimson\Brand\Model\Api\SearchCriteria\CollectionProcessor\BrandFilterProcessor" type="Magento\Framework\Api\SearchCriteria\CollectionProcessor\FilterProcessor">
        <arguments>
            <argument name="customFilters" xsi:type="array">
                <item name="store_id" xsi:type="object">Crimson\Brand\Model\Api\SearchCriteria\CollectionProcessor\FilterProcessor\BrandStoreFilter</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Crimson\Brand\Model\Api\SearchCriteria\BrandCollectionProcessor" type="Magento\Framework\Api\SearchCriteria\CollectionProcessor">
        <arguments>
            <argument name="processors" xsi:type="array">
                <item name="filters" xsi:type="object">Crimson\Brand\Model\Api\SearchCriteria\CollectionProcessor\BrandFilterProcessor</item>
                <item name="sorting" xsi:type="object">Magento\Framework\Api\SearchCriteria\CollectionProcessor\SortingProcessor</item>
                <item name="pagination" xsi:type="object">Magento\Framework\Api\SearchCriteria\CollectionProcessor\PaginationProcessor</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Magento\SalesRule\Model\Rule\Condition\Product">
        <plugin name="Crimson_Brand_SalesRule_Model_Rule_Condition_Plugin" type="Crimson\Brand\Plugin\Model\Rule\Condition\ProductPlugin" sortOrder="10" disabled="false"  />
    </type>
    <preference for="Magento\Catalog\Block\Product\ListProduct" type="Crimson\Brand\Block\Product\ListProduct" />
</config>