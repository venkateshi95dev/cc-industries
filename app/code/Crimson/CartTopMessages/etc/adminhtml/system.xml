<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="checkout">
            <group id="cart">
                <label>Cart Messages</label>
                <field id="cart_top_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Cart Top Message</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="discount_number" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cart Discount Amount</label>
                    <comment><![CDATA[Represents the amount of discount. 850 by default.]]></comment>
                    <validate>validate-number</validate>
                </field>
                <field id="discount_number_compare" translate="label comment" type="text" sortOrder="81" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cart Number Compare Discount Amount</label>
                    <comment><![CDATA[Number will be compared with Discount Amount to display messages. 600 by default.]]></comment>
                    <validate>validate-number</validate>
                </field>
                <field id="cart_top_not_qualified_message" translate="label" type="textarea" sortOrder="82" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cart Top Not Qualified Message</label>
                    <comment><![CDATA[This is the Cart top message when the customer has not qualified yet.]]></comment>
                </field>
                <field id="cart_top_qualified_message" translate="label" type="textarea" sortOrder="83" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cart Top Qualified Message</label>
                    <comment><![CDATA[This is the Cart top message when the customer has qualified.]]></comment>
                </field>
                <field id="cart_top_messages_modal_text" translate="label" type="textarea" sortOrder="84" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cart Top Modal Text</label>
                    <comment><![CDATA[This is the text for the Modal that pops up explaining the Discount.]]></comment>
                </field>
                <field id="cart_sidebar_shipping_atypical_message" translate="label" type="textarea" sortOrder="85" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cart Sidebar Shipping Atypical Message</label>
                    <comment><![CDATA[This is the text for the warning on the sidebar when shipping method is atypical.]]></comment>
                </field>
                <field id="cart_top_messages_customer_groups" translate="label" type="multiselect" sortOrder="86" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cart Top Messages Customer Groups</label>
                    <source_model>Crimson\CartTopMessages\Model\Customer\Source\Group</source_model>
                    <comment><![CDATA[When customer is logged in these are the customer groups able to check the discount messages.]]></comment>
                </field>
            </group>
        </section>
    </system>
</config>
