<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Crimson\Category\Block\Category\Sections\MostViewed" name="crimson.category.bottom.mostViewed" template="Crimson_Category::most_viewed.phtml" after="-">
                <action method="setLimit">
                    <argument name="limit" xsi:type="string">15</argument>
                </action>
                <action method="setHeader">
                    <argument name="header" xsi:type="string">Most Viewed From </argument>
                </action>
            </block>
        </referenceContainer>
    </body>
</page>
