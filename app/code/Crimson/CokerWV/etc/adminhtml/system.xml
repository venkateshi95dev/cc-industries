<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers">
            <group id="lofproductshipping" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Lof Per Product Shipping Detail</label>
                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="name" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Name</label>
                </field>
                <field id="defaultprice" translate="label" type="text" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Shipping Price</label>
                    <validate>validate-number required-entry</validate>
                </field>
                <field id="shippingbasedon" translate="label" type="select" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Shipping Based On</label>
                    <source_model>Crimson\CokerWV\Model\Config\Source\ShippingBasedOn</source_model>
                </field>
                <field id="sallowspecific" translate="label" type="select" sortOrder="7" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Ship to Applicable Countries</label>
                    <frontend_class>shipping-applicable-country</frontend_class>
                    <source_model>Magento\Shipping\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="7" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Ship to Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
            </group>
            <group id="fedex">
                <field id="max_bundle_weight_for_shipping" translate="label" type="text" showInDefault="1" sortOrder="800">
                    <label>Maximum Weight</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="enabled_for_stores" translate="label" type="multiselect" sortOrder="900" showInDefault="1">
                    <label>Enabled For Stores</label>
                    <source_model>Magento\Config\Model\Config\Source\Store</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
            </group>
        </section>
        <section id="checkout">
            <group id="options">
                <field id="storepickup_label" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Store Pickup toggle label</label>
                    <comment>Text shown next to the Store Pickup toggle on the Shipping step.</comment>
                </field>
                <field id="storepickup_message_html" translate="label comment" type="textarea" sortOrder="21" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Store Pickup message (HTML)</label>
                    <comment>Rendered under the Store Pickup toggle on the Shipping step. HTML allowed (e.g., links).</comment>
                </field>
            </group>
        </section>
    </system>
</config>
