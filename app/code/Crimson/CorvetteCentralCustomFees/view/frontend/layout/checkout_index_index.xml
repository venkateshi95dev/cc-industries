<?xml version="1.0" encoding="UTF-8" ?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="sidebar" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="summary" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="totals" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="custom_fees" xsi:type="array">
                                                            <item name="component" xsi:type="string">Crimson_CorvetteCentralCustomFees/js/view/checkout/summary/custom_fees</item>                                                            <item name="sortOrder" xsi:type="string">50</item>
                                                            <item name="config" xsi:type="array">
                                                                <item name="titlecore" xsi:type="string">Fee - Core Charge</item>
                                                                <item name="titlecrate" xsi:type="string">Fee - Oversize Shipping / Crate</item>
                                                                <item name="titlefreight" xsi:type="string">Fee - Freight</item>
                                                                <item name="titledropship" xsi:type="string">Fee - Dropshipping</item>
                                                                <item name="titletruckfrtseeitem" xsi:type="string">Truck Freight Prepaid - See Item 0070</item>
                                                                <item name="titletruckfrtsetprice" xsi:type="string">Truck Freight Prepaid - Set Price</item>
                                                                <item name="titlecanadataxes" xsi:type="string">Taxes (Canada)</item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="billing_address_totals_observer"
                   template="Crimson_CorvetteCentralCustomFees::billing-totals-observer.phtml"/>
        </referenceContainer>
    </body>
</page>
