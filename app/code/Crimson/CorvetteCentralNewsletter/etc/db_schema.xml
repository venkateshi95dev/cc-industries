<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="newsletter_subscriber">
        <column xsi:type="varchar" name="first_name" nullable="true" length="255" comment="First Name"/>
        <column xsi:type="varchar" name="last_name" nullable="true" length="255" comment="Last Name"/>
        <column xsi:type="varchar" name="region" nullable="true" length="255" comment="Where do you live?"/>
        <column xsi:type="varchar" name="model_years" nullable="true" length="255" comment="What year of Corvette do you own?"/>
    </table>
</schema>
