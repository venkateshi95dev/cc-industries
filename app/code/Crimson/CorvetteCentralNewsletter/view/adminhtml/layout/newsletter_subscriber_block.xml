<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="adminhtml.newslettrer.subscriber.grid.columnSet.firstname" remove="true" />
        <referenceBlock name="adminhtml.newslettrer.subscriber.grid.columnSet.lastname" remove="true" />

        <referenceBlock name="adminhtml.newslettrer.subscriber.grid.columnSet">
            <block class="Magento\Backend\Block\Widget\Grid\Column" after="status"
                name="adminhtml.newslettrer.subscriber.grid.columnSet.model_years" as="model_years">
                <arguments>
                    <argument name="header" xsi:type="string" translate="true">Corvette Model Years</argument>
                    <argument name="index" xsi:type="string">model_years</argument>
                </arguments>
            </block>

            <block class="Magento\Backend\Block\Widget\Grid\Column" after="status"
                name="adminhtml.newslettrer.subscriber.grid.columnSet.region" as="region">
                <arguments>
                    <argument name="header" xsi:type="string" translate="true">Region</argument>
                    <argument name="index" xsi:type="string">region</argument>
                </arguments>
            </block>

            <block class="Crimson\CorvetteCentralNewsletter\Block\Adminhtml\Subscriber\Grid\Column\LastNameColumn" after="type"
                name="adminhtml.newsletrer.subscriber.grid.columnSet.last_name" as="last_name">
                <arguments>
                    <argument name="header" xsi:type="string" translate="true">Last Name</argument>
                    <argument name="index" xsi:type="string">last_name</argument>
                </arguments>
            </block>

            <block class="Crimson\CorvetteCentralNewsletter\Block\Adminhtml\Subscriber\Grid\Column\FirstNameColumn" after="type"
                   name="adminhtml.newslettrer.subscriber.grid.columnSet.first_name" as="first_name">
                <arguments>
                    <argument name="header" xsi:type="string" translate="true">First Name</argument>
                    <argument name="index" xsi:type="string">first_name</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
