<?xml version="1.0" encoding="UTF-8" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="crimson" translate="label" sortOrder="300">
            <label>Crimson</label>
        </tab>

        <section id="crimson_general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Theme</label>
            <tab>crimson</tab>

            <resource>Magento_Config::config</resource>

            <group id="styleguide" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Enable Styleguide Route</label>
                
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>creates a route for testing components styles for Central theme</comment>
                    <tooltip>route visible at theme/styleguide</tooltip>
                </field>
            </group>
        </section>
    </system>
</config>
