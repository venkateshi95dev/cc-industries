<?xml version="1.0"?>
<!--
/**
 * Crimson Agility, LLC
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="customer_register_success">
        <observer name="customer_create_demographics" instance="Crimson\Demographics\Observer\CustomerCreate" />
    </event>
    <event name="customer_account_edited">
        <observer name="customer_edit_demographics" instance="Crimson\Demographics\Observer\CustomerEdit" />
    </event>

    <!-- Adds to MACH Request Add Order -->
    <event name="mach_add_order_before_request">
        <observer instance="Crimson\Demographics\Observer\MachAddOrderBeforeRequestDemographics" name="crimson_demographics"/>
    </event>

    <event name="sales_model_service_quote_submit_before">
        <observer name="Crimson_Demographics_sales_model_service_quote_submit_before" instance="Crimson\Demographics\Observer\SaveOrderBeforeSalesModelQuoteObserver" />
    </event>
</config>