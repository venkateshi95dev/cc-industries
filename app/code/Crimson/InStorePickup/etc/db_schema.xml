<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="inventory_source">
        <column xsi:type="int" name="website_id" padding="10" unsigned="true" nullable="false" default="0" comment="Website ID"/>
        <column xsi:type="text" name="allowed_sku" nullable="true" comment="Source Allowed SKUs"/>
    </table>

    <table name="quote_address">
        <column xsi:type="varchar" name="source_code" nullable="true" length="20" comment="Quote Address Source Code Selected"/>
        <column xsi:type="varchar" name="source_email" nullable="true" length="255" comment="Quote Address Source Email"/>
    </table>

    <table name="sales_order">
        <column xsi:type="varchar" name="source_code" nullable="true" length="20" comment="Quote Address Source Code Selected"/>
        <column xsi:type="varchar" name="source_email" nullable="true" length="255" comment="Quote Address Source Email"/>
    </table>
</schema>
