<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\InventoryInStorePickup\Model\ResourceModel\GetPickupLocationIntersectionForSkus"
                type="Crimson\InStorePickup\Model\ResourceModel\GetPickupLocationIntersectionForSkusCustom" />

    <type name="Magento\InventoryApi\Api\SourceRepositoryInterface">
        <plugin name="crimson_save_in_store_pickup_links" type="Crimson\InStorePickup\Plugin\InventoryApi\SourceRepository\SaveInStorePickupPlugin"/>
        <plugin name="crimson_load_in_store_pickup_on_get_list" type="Crimson\InStorePickup\Plugin\InventoryApi\SourceRepository\LoadInStorePickupOnGetListPlugin"/>
        <plugin name="crimson_load_in_store_pickup_on_get" type="Crimson\InStorePickup\Plugin\InventoryApi\SourceRepository\LoadInStorePickupOnGetPlugin"/>
    </type>

    <type name="Magento\InventoryInStorePickupApi\Model\SearchCriteriaResolverInterface">
        <arguments>
            <argument name="resolvers" xsi:type="array">
                <item name="resolve-scope-filter" xsi:type="object">Crimson\InStorePickup\Model\SearchCriteria\ResolveScopeFilter</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin sortOrder="1" name="crimsonSourceInfoOrderRepositoryInterface" type="Crimson\InStorePickup\Plugin\Api\OrderRepositoryInterfacePlugin"/>
    </type>

    <preference for="Magento\Sales\Model\Order\Email\SenderBuilder"
                type="Crimson\InStorePickup\Model\Order\Email\SenderBuilderCustom" />

    <preference for="Magento\InventoryInStorePickupQuote\Model\IsPickupLocationShippingAddress"
                type="Crimson\InStorePickup\Model\IsPickupLocationShippingAddressCustom" />
</config>
