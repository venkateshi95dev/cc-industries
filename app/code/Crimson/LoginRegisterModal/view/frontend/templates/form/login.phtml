<script>

    var SignInModal = {};

    require([
        'jquery',
        'Magento_Ui/js/modal/modal',
        'domReady!'
    ], function ($, modal) {
        $(function () { // to ensure that code evaluates on page load
            var loginOptions = {
                type: 'popup',
                responsive: true,
                innerScroll: true,
                focus: '.block-title',
                modalClass: 'custom-block-customer-login',
                buttons: false
            };

            var headerElem = $('.header.content');
            var accountMenu = headerElem.find('.account-menu');
            var loginLink = headerElem.find('a.log-in');

            loginLink.click(function(e){
                e.preventDefault();
                accountMenu.off();
            });

            if ($('#popup-modal').length > 0) {
                modal(loginOptions, $('#popup-modal'));
            }

            loginLink.on('click', function (e) {
                e.preventDefault();
                $('#popup-modal').modal("openModal");
            });

            SignInModal.open = function () {
                $('#popup-modal').modal("openModal");
            };
        });
    });
</script>

