<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="MachLogDebug" type="Crimson\MachBase\Model\Api\Logger">
        <arguments>
            <argument name="name" xsi:type="string">mach_debug</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="handler" xsi:type="object">Crimson\MachBase\Model\Logger\Handler\Debug</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="MachLogInfo" type="Crimson\MachBase\Model\Api\Logger">
        <arguments>
            <argument name="name" xsi:type="string">mach_info</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="handler" xsi:type="object">Crimson\MachBase\Model\Logger\Handler\Info</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="MachLogCritical" type="Crimson\MachBase\Model\Api\Logger">
        <arguments>
            <argument name="name" xsi:type="string">mach_critical</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="handler" xsi:type="object">Crimson\MachBase\Model\Logger\Handler\Critical</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Crimson\MachBase\Model\Log">
        <arguments>
            <argument name="debugLog" xsi:type="object">MachLogDebug</argument>
            <argument name="infoLog" xsi:type="object">MachLogInfo</argument>
            <argument name="critical" xsi:type="object">MachLogCritical</argument>
        </arguments>
    </type>
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="mach/settings/security_code" xsi:type="string">1</item>
            </argument>
            <argument name="environment" xsi:type="array">
                <item name="mach/settings/wsdl_url" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
</config>
