<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="crimson_machcatalog" instance="Crimson\MachCatalog\Observer\SetMachHscOnOrderSubmit" />
    </event>
    <event name="sales_quote_address_save_before">
        <observer name="backorderMachHsc" instance="Crimson\MachCatalog\Observer\SaveQuoteAddressMachHsc" />
    </event>
    <event name="sales_quote_product_add_after">
        <observer name="crimsonDropshipQuoteItem" instance="Crimson\MachCatalog\Observer\AddItemsToQuoteDropshipUpdate" />
    </event>
</config>
