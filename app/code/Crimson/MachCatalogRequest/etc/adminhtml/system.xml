<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="mach">
            <group id="catalog_request" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Catalog Request Settings</label>
                <field id="enabled" type="select" translate="label" sortOrder="0" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="footer_request_catalog_image_url" translate="label" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Footer Request Catalog Image URL</label>
                    <validate>validate-url</validate>
                </field>
                <field id="available_catalogs" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Available Catalogs</label>
                    <frontend_model>Crimson\MachCatalogRequest\Block\Adminhtml\Form\Field\AvailableCatalogs</frontend_model>
                    <backend_model>Crimson\MachCatalogRequest\Model\System\Config\Backend\ArraySerialized</backend_model>
                </field>
            </group>
        </section>

        <section id="recaptcha_frontend">
            <group id="type_for">
                <field id="mach_catalog_request" translate="label" type="select" sortOrder="1337" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Mach Catalog Request</label>
                    <source_model>Magento\ReCaptchaAdminUi\Model\OptionSource\Type</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
