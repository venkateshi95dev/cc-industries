<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="mach">
        <job name="crimson_customer_export_to_mach" instance="Crimson\MachCustomer\Cron\ExportCustomersMach" method="execute">
            <config_path>mach/customer/customer_export_schedule</config_path>
        </job>
        <job name="crimson_customer_update_from_mach" instance="Crimson\MachCustomer\Cron\UpdateCustomersFromMach" method="execute">
            <config_path>mach/customer/customer_update_schedule</config_path>
        </job>
    </group>
</config>