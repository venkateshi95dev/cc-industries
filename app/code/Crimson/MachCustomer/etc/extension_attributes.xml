<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/extension_attributes.xsd">
    <extension_attributes for="Magento\Sales\Api\Data\OrderInterface">
        <attribute code="mach_customer_number" type="boolean">
            <join reference_table="sales_order_mach_customer" join_on_field="entity_id" reference_field="order_id">
                <field>mach_customer_number</field>
            </join>
        </attribute>
    </extension_attributes>
    <extension_attributes for="Magento\Customer\Api\Data\GroupInterface">
        <attribute code="customer_price_level" type="string">
            <join reference_table="customer_group_extension_attributes" reference_field="customer_group_id" join_on_field="customer_group_id">
                <field>customer_price_level</field>
            </join>
        </attribute>
        <attribute code="mach_tax_exempt" type="string">
            <join reference_table="customer_group_extension_attributes" reference_field="customer_group_id" join_on_field="customer_group_id">
                <field>mach_tax_exempt</field>
            </join>
        </attribute>
        <attribute code="mach_tax_non_exempt" type="string">
            <join reference_table="customer_group_extension_attributes" reference_field="customer_group_id" join_on_field="customer_group_id">
                <field>mach_tax_non_exempt</field>
            </join>
        </attribute>
    </extension_attributes>
</config>