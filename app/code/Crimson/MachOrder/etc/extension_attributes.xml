<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/extension_attributes.xsd">
    <extension_attributes for="Magento\Sales\Api\Data\OrderInterface">
        <attribute code="mach_order_number" type="string">
            <join reference_table="sales_order_mach_order" join_on_field="entity_id" reference_field="order_id">
                <field>mach_order_number</field>
            </join>
        </attribute>
        <attribute code="mach_submitted" type="bool">
            <join reference_table="sales_order_mach_order" join_on_field="entity_id" reference_field="order_id">
                <field>mach_submitted</field>
            </join>
        </attribute>
        <attribute code="mach_submitted_at" type="string">
            <join reference_table="sales_order_mach_order" join_on_field="entity_id" reference_field="order_id">
                <field>mach_submitted_at</field>
            </join>
        </attribute>
        <attribute code="mach_update_scheduled" type="bool">
            <join reference_table="sales_order_mach_order" join_on_field="entity_id" reference_field="order_id">
                <field>mach_update_scheduled</field>
            </join>
        </attribute>
        <attribute code="mach_submit_error_count" type="int">
            <join reference_table="sales_order_mach_order" join_on_field="entity_id" reference_field="order_id">
                <field>mach_submit_error_count</field>
            </join>
        </attribute>
        <attribute code="mach_submit_last_error_number" type="int">
            <join reference_table="sales_order_mach_order" join_on_field="entity_id" reference_field="order_id">
                <field>mach_submit_last_error_number</field>
            </join>
        </attribute>
        <attribute code="mach_submit_last_error_message" type="string">
            <join reference_table="sales_order_mach_order" join_on_field="entity_id" reference_field="order_id">
                <field>mach_submit_last_error_message</field>
            </join>
        </attribute>
        <attribute code="mach_submit_hold" type="boolean">
            <join reference_table="sales_order_mach_order" join_on_field="entity_id" reference_field="order_id">
                <field>mach_submit_hold</field>
            </join>
        </attribute>
    </extension_attributes>

    <extension_attributes for="Magento\Sales\Api\Data\ShipmentTrackInterface">
        <attribute code="mach_package_id" type="string">
            <join reference_table="sales_shipment_track_mach_data" join_on_field="entity_id" reference_field="track_id">
                <field>mach_package_id</field>
            </join>
        </attribute>
        <attribute code="mach_custom_track_url" type="string">
            <join reference_table="sales_shipment_track_mach_data" join_on_field="entity_id" reference_field="track_id">
                <field>mach_custom_track_url</field>
            </join>
        </attribute>
    </extension_attributes>
</config>