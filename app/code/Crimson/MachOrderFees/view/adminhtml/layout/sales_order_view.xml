<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="order_totals">
            <block class="Crimson\MachOrderFees\Block\Sales\Order\Total\CoreCharge" name="mach.order.fee.corecharge">
                <action method="setBeforeCondition">
                    <argument name="condition" xsi:type="string">shipping</argument>
                </action>
            </block>
            <block class="Crimson\MachOrderFees\Block\Sales\Order\Total\AdditionalHandling" name="mach.order.fee.additional.handling">
                <action method="setBeforeCondition">
                    <argument name="condition" xsi:type="string">shipping</argument>
                </action>
            </block>
        </referenceBlock>
    </body>
</page>
