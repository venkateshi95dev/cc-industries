<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.cart.totals">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="block-totals" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="before_grandtotal" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="core_charge_total" xsi:type="array">
                                            <item name="component" xsi:type="string">Crimson_MachOrderFees/js/checkout/cart/totals/core_charge_total</item>
                                            <item name="config" xsi:type="array">
                                                <!--<item name="template" xsi:type="string">Crimson_MachOrderFees/checkout/cart/totals/core_charge</item>-->
                                                <item name="title" xsi:type="string">Core Charges</item>
                                                <item name="level" xsi:type="string">item</item>
                                            </item>
                                        </item>
                                        <item name="additional_handling_total" xsi:type="array">
                                            <item name="component" xsi:type="string">Crimson_MachOrderFees/js/checkout/cart/totals/additional_handling_total</item>
                                            <item name="config" xsi:type="array">
                                                <!--<item name="template" xsi:type="string">Crimson_MachOrderFees/checkout/cart/totals/additional_handling_total</item>-->
                                                <item name="title" xsi:type="string">Additional Handling</item>
                                                <item name="level" xsi:type="string">item</item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>