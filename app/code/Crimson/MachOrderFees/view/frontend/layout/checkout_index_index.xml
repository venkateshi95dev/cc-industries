<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="sidebar" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="summary" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="totals" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="before_grandtotal" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="core_charges" xsi:type="array">
                                                                    <item name="component"  xsi:type="string">Crimson_MachOrderFees/js/checkout/view/summary/core_charge_total</item>
                                                                    <item name="config" xsi:type="array">
                                                                        <item name="title" xsi:type="string">Core Charges</item>
                                                                        <item name="level" xsi:type="string">item</item>
                                                                    </item>
                                                                </item>
                                                                <item name="additional_handling" xsi:type="array">
                                                                    <item name="component"  xsi:type="string">Crimson_MachOrderFees/js/checkout/view/summary/additional_handling_total</item>
                                                                    <item name="config" xsi:type="array">
                                                                        <item name="title" xsi:type="string">Additional Handling</item>
                                                                        <item name="level" xsi:type="string">item</item>
                                                                    </item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
