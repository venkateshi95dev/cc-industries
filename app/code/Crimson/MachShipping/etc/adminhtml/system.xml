<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
<system>
    <section id="carriers" translate="label" type="text" sortOrder="320" showInDefault="1" showInWebsite="1" showInStore="0">
        <group id="mach" translate="label" type="text" sortOrder="0" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Mach Shipping</label>
            <field id="active" translate="label" type="select" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Enabled</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            </field>
            <field id="title" translate="label comment" sortOrder="3" type="text" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Title</label>
                <comment>Shipping Title Text</comment>
            </field>
            <field id="carrier_in_use" translate="label" type="select" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Carrier In Use</label>
                <source_model>Crimson\MachShipping\Model\Shipping\Carrier\Source\MachCarriers</source_model>
                <comment>MACH carrier currently being used.</comment>
            </field>
            <field id="description" translate="label comment" sortOrder="4" type="textarea" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Description Message</label>
                <comment>Shipping Description Message</comment>
            </field>
            <field id="max_package_weight" translate="label comment" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Maximum Package Weight</label>
                <validate>validate-number validate-zero-or-greater</validate>
                <comment>Please consult your shipping carrier for maximum supported shipping weight</comment>
            </field>
            <field id="sallowspecific" translate="label" type="select" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Ship to Applicable Countries</label>
                <frontend_class>shipping-applicable-country</frontend_class>
                <source_model>Magento\Shipping\Model\Config\Source\Allspecificcountries</source_model>
            </field>
            <field id="specificcountry" translate="label" type="multiselect" sortOrder="7" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Ship to Specific Countries</label>
                <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                <can_be_empty>1</can_be_empty>
            </field>
            <field id="showmethod" translate="label" type="select" sortOrder="8" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Show Method if Not Applicable</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            </field>
            <field id="allowed_methods" translate="label" type="multiselect" sortOrder="9" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Allowed Methods</label>
                <source_model>Crimson\MachShipping\Model\Shipping\Carrier\Source\Method</source_model>
                <can_be_empty>1</can_be_empty>
            </field>
            <field id="fallback_shipping_method" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Fallback Method</label>
                <source_model>Crimson\MachShipping\Model\Shipping\Carrier\Source\Method</source_model>
                <can_be_empty>1</can_be_empty>
                <comment>If MACH went down and a backup shipping method was used, this MACH method will be sent instead.</comment>
            </field>
            <field id="allow_if_zero" translate="label" type="multiselect" sortOrder="11" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Allowed If $0 Methods</label>
                <source_model>Crimson\MachShipping\Model\Shipping\Carrier\Source\Method</source_model>
                <can_be_empty>1</can_be_empty>
            </field>
            <field id="allow_if_dropship" translate="label" type="multiselect" sortOrder="12" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Allow If Dropship/Backorder/Hazardous Materials</label>
                <source_model>Crimson\MachShipping\Model\Shipping\Carrier\Source\Method</source_model>
                <can_be_empty>1</can_be_empty>
            </field>
            <field id="eta_enabled" translate="label" type="select" sortOrder="13" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Display/Enabled ETA</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            </field>
            <field id="holidays_enabled" translate="label" type="select" sortOrder="14" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>ETA Account For Holidays</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            </field>
            <field id="weekend_enabled" translate="label" type="select" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>ETA Account For Weekends</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            </field>
            <field id="non_delivery_holidays" translate="label comment" type="text" sortOrder="16" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>ETA Non-Delivery Holidays</label>
                <comment>Enter the non-delivery holidays, enter the dates separated by comas. Format MM/DD</comment>
            </field>
            <field id="time_in_transit_message" translate="label" type="textarea" sortOrder="17" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>ETA Clarification Message</label>
                <comment><![CDATA[Time in transit clarification message ]]></comment>
            </field>
            <field id="sort_order" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Sort Order</label>
            </field>
        </group>
    </section>

    <section id="mach">
        <group id="shipping" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Mach Shipping</label>
            <field id="freeshipping_code" type="text" translate="label comment" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Freeshipping Code</label>
            </field>
            <field id="flatrate_code" type="text" translate="label comment" sortOrder="11" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Flatrate Code</label>
            </field>
        </group>
    </section>
</system>
</config>
