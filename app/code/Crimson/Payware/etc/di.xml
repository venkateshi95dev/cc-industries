<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="mach/settings/security_code" xsi:type="string">1</item>
                <item name="payment/payware/user_id" xsi:type="string">1</item>
                <item name="payment/payware/user_password" xsi:type="string">1</item>
                <item name="payment/payware/client_id" xsi:type="string">1</item>
                <item name="payment/payware/merchant_key" xsi:type="string">1</item>
            </argument>
            <argument name="environment" xsi:type="array">
                <item name="mach/settings/wsdl_url" xsi:type="string">1</item>
                <item name="payment/payware/test" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>

    <preference for="Magento\Checkout\Model\GuestPaymentInformationManagement" type="Crimson\Payware\Model\GuestPaymentInformationManagementCustom"/>
    <preference for="Magento\Checkout\Model\PaymentInformationManagement" type="Crimson\Payware\Model\PaymentInformationManagementCustom"/>
</config>
