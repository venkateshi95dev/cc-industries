<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Block\Onepage">
        <arguments>
            <argument name="layoutProcessors" xsi:type="array">
                <item name="crimson_po_box_restriction_layoutprocessor" xsi:type="object">Crimson\PoBoxRestriction\Block\Checkout\LayoutProcessor</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Customer\Controller\Account\CreatePost">
        <plugin name="PoBoxRestrictionAccountCreatePostPlugin" type="Crimson\PoBoxRestriction\Plugin\Controller\Account\PoBoxRestriction"/>
    </type>
    <type name="Magento\Customer\Controller\Address\FormPost">
        <plugin name="PoBoxRestrictionAddressFormPostPlugin" type="Crimson\PoBoxRestriction\Plugin\Controller\Address\PoBoxRestriction"/>
    </type>
</config>