                <field id="physical_value_cutoff" translate="label comment" type="text" sortOrder="7" showInStore="1" showInWebsite="1" showInDefault="1">
                    <label>Physical Value Cutoff</label>
                    <comment>Any package with a value higher than this amount will not allow this shipping method.</comment>
                    <validate>validate-number</validate>
                </field>
                <field id="weight_value_cutoff" translate="label comment" type="text" sortOrder="7" showInStore="1" showInWebsite="1" showInDefault="1">
