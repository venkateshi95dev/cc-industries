        <section id="shipping">
            <group id="cart_sidebar_messaging" translate="label" type="text" sortOrder="150"
                showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cart Sidebar Messaging</label>
                <field id="enable_cart_sidebar_tax_message" translate="label" type="select" sortOrder="100"
                    showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Enable Cart Sidebar Tax Message</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="cart_sidebar_tax_message" translate="label" type="textarea" sortOrder="101"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Cart Sidebar Tax Message</label>
                    <comment>Accepts HTML. Allowed tags: span, strong, br, ul, ol, li, p, div</comment>
                    <depends>
                        <field id="enable_shipping_policy">1</field>
                    </depends>
                </field>
                <field id="enable_cart_sidebar_shipping_update" translate="label" type="select" sortOrder="105"
                    showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Enable Cart Sidebar Shipping Update</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="cart_sidebar_shipping_update" translate="label" type="textarea" sortOrder="106"
                    showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Cart Sidebar Shipping Update</label>
                    <comment>Accepts HTML. Allowed tags: span, strong, br, ul, ol, li, p, div</comment>
                    <depends>
                        <field id="enable_shipping_policy">1</field>
                    </depends>
                </field>
            </group>
