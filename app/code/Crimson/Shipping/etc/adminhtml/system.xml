                    <label>Displayed Error Message</label>
                </field>
            </group>
            <group id="freeshipping" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <field id="regions_excluded" translate="label comment" type="multiselect" sortOrder="95" showInDefault="1" showInWebsite="1">
                    <label>Excluded Regions</label>
                    <source_model>Crimson\Shipping\Model\Directory\Config\Source\USRegions</source_model>
                    <comment><![CDATA[Selected US regions will be excluded from this shipping method.]]></comment>
                </field>
            </group>
