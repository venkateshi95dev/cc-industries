                <field id="mach_shipvia_code" translate="label comment" type="text" sortOrder="8" showInStore="1" showInWebsite="1" showInDefault="1">
                    <label>Mach Shipping Code</label>
                    <comment>This is the shipping method code that will be sent to Mach.</comment>
