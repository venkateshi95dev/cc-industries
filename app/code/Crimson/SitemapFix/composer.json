  "require": {
    "php": "~7.4.0",
    "magento/module-sitemap": "*",
    "magento/magento-composer-installer": "*"
  },
  "suggest": {
  },
  "type": "magento2-module",
  "version": "2.3.0",
  "license": [
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Crimson\\SitemapFix\\": ""
    }
  },
  "extra": {
    "map": [
      [
        "*",
        "Crimson/SitemapFix"
      ]
    ]
  }
}
