<?xml version="1.0" encoding="UTF-8" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\HTTP\PhpEnvironment\RemoteAddress">
        <arguments>
            <argument name="alternativeHeaders" xsi:type="array">
                <item name="cloudflare-connecting-ip" xsi:type="string">HTTP_CF_CONNECTING_IP</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Filter\StripTags">
        <plugin name="Crimson_Theme::Plugin\Filter\StripTags" type="Crimson\Theme\Plugin\Filter\StripTags" />
    </type>
</config>
