<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Ebizcharge_Ebizcharge::rec" title=" EBizCharge Payment Module" sortOrder="10">

                    <!--ACL for Admin Menu Items-->
                    <resource id="Ebizcharge_Ebizcharge::menu" title="EBizCharge Menu" sortOrder="10">
                        <resource id="Ebizcharge_Ebizcharge::menu_product_subscriptions"
                                  title=" Product Subscriptions Menu" sortOrder="10">
                            <resource id="Ebizcharge_Ebizcharge::menu_product_subscriptions_addnew"
                                      title=" Add New Subscriptions Menu" sortOrder="10"/>
                            <resource id="Ebizcharge_Ebizcharge::menu_product_subscriptions_scheduled"
                                      title=" Scheduled Subscriptions Menu" sortOrder="20"/>
                            <resource id="Ebizcharge_Ebizcharge::menu_product_subscriptions_history"
                                      title=" Subscriptions History Menu" sortOrder="30"/>
                            <resource id="Ebizcharge_Ebizcharge::menu_product_subscriptions_search"
                                      title=" Search Subscriptions Menu" sortOrder="40"/>
                            <resource id="Ebizcharge_Ebizcharge::menu_subscription_orders"
                                      title=" Menu Subscription Order" sortOrder="50"/>
                        </resource>

                        <!--Sync Assets Menu for Upload and Download Assets with Ebizcharge-->
                        <resource id="Ebizcharge_Ebizcharge::menu_sync_assets" title=" Menu Download Resources"
                                  sortOrder="30"/>
                        <!--Meu Configuration-->
                        <resource id="Ebizcharge_Ebizcharge::menu_configuration" title=" Menu Configuration"
                                  sortOrder="40"/>
                        <!--Menu for Help and Support-->
                        <resource id="Ebizcharge_Ebizcharge::menu_help_support" title=" Menu Help | Support"
                                  sortOrder="50"/>
                        <!--Menu for Cron Jobs Management-->
                        <resource id="Ebizcharge_Ebizcharge::menu_cron_management" title=" Cron Jobs Management"
                                  sortOrder="60">
                        </resource>
                    </resource>

                    <!--ACL for Admin Actions-->
                    <resource id="Ebizcharge_Ebizcharge::admin_actions" title=" EBizCharge Admin Actions" sortOrder="20">
                        <resource id="Ebizcharge_Ebizcharge::admin_actions_ach" title=" Admin Actions ACH"
                                  sortOrder="10">
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_ach_index" title=" ACH Index Action"
                                      sortOrder="10"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_ach_add" title=" ACH Add Action"
                                      sortOrder="20"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_ach_save" title=" ACH Save Action"
                                      sortOrder="30"/>
                        </resource>

                        <!--ACL for Cards-->
                        <resource id="Ebizcharge_Ebizcharge::admin_actions_cards" title=" Admin Actions Cards"
                                  sortOrder="20">
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_cards_index" title=" Cards Action Index"
                                      sortOrder="10"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_cards_add" title=" Cards Actions Add"
                                      sortOrder="20"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_cards_save" title=" Cards Actions Save"
                                      sortOrder="30"/>
                        </resource>
                        <!--ACL for Cards-->
                        <resource id="Ebizcharge_Ebizcharge::admin_actions_download" title=" Admin Actions Downloads"
                                  sortOrder="20">
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_download_ebizcharge_resources"
                                      title=" Download EBizCharge Resources"
                                      sortOrder="10"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_upload_ebizcharge_resources"
                                      title=" Upload EBizCharge Resources"
                                      sortOrder="20"/>
                        </resource>

                        <!--ACL for Help and Support-->
                        <resource id="Ebizcharge_Ebizcharge::admin_actions_help" title=" Admin Actions Help | Support"
                                  sortOrder="30"/>


                        <!--ACL for Subscription Orders-->
                        <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders"
                                  title=" Admin Actions Subscription Orders" sortOrder="40">
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_add"
                                      title=" Subscriptions Add" sortOrder="10"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_create_order"
                                      title=" Subscriptions Create Order" sortOrder="20"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_edit"
                                      title=" Subscriptions Orders Edit" sortOrder="30"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_delete"
                                      title=" Subscriptions Orders Delete" sortOrder="40"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_email"
                                      title=" Subscriptions Orders Email" sortOrder="50"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_history"
                                      title=" Actions Subscriptions Orders History" sortOrder="60"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_save"
                                      title=" Actions Subscriptions Orders Save" sortOrder="70"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_search"
                                      title=" Subscriptions Search Orders" sortOrder="80"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_suspend"
                                      title=" Subscriptions Orders Suspend" sortOrder="90"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_suspend_unsubscribe"
                                      title=" Subscriptions Unsubscribe" sortOrder="100"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_update_status"
                                      title=" Update Subscriptions Status" sortOrder="110"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_print"
                                      title=" Actions Subscriptions Print" sortOrder="120"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_subscriptions_orders_index"
                                      title=" Subscriptions Grid" sortOrder="130"/>
                            <resource id="Ebizcharge_Ebizcharge::admin_actions_recurring_emailbulkaction"
                                      title=" Recurring SendEmail" sortOrder="140"/>
                        </resource>



                    </resource>
                </resource>

                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Ebizcharge_Ebizcharge::stores_configuration" title=" Ebizcharge Configuration"
                                      sortOrder="10"/>

                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
