<config xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
        xsi:noNamespaceSchemaLocation='urn:magento:framework/Event/etc/events.xsd'>
<!--    <event name="adminhtml_customer_save_after">-->
<!--        <observer name="Ebizcharge_Ebizcharge_Addcustomer" instance="Ebizcharge\Ebizcharge\Observer\Addcustomer"/>-->
<!--    </event>-->
    <event name="checkout_submit_all_after">
        <observer name="Ebizcharge_Ebizcharge_AddOrder" instance="Ebizcharge\Ebizcharge\Observer\AddOrder"/>
    </event>
    <event name="sales_order_invoice_register">
        <observer name="Ebizcharge_Ebizcharge_AddInvoice" instance="Ebizcharge\Ebizcharge\Observer\AddInvoice"/>
    </event>
    <event name="admin_system_config_changed_section_payment">
        <observer name="custom_admin_system_config_changed_section_payment"
                  instance="Ebizcharge\Ebizcharge\Observer\ConfigObserver"/>
    </event>

    <!-- To update Ebiz field 'Unit of Measure' when Magento 'Weight Unit' field updated -->
    <event name="admin_system_config_changed_section_general">
        <observer name="update_ebiz_unit_of_measure"
                  instance="Ebizcharge\Ebizcharge\Observer\Config\GeneralSection\UpdateEbizFields"/>
    </event>
</config>
