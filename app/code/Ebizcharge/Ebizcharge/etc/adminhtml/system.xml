                <field id="payment_action" translate="label" type="select" sortOrder="320" showInDefault="1"
                       showInWebsite="1" showInStore="1" >
                    <label>Payment Action</label>
                    <source_model>Ebizcharge\Ebizcharge\Model\Source\PaymentAction</source_model>
                    <comment>
                        <![CDATA["Authorize Only" only pre-authorizes the customer’s card for purchase amount. "Authorize and Capture" pre-authorizes the customer’s card and collects funds at the same time.]]></comment>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>

                <field id="void_order_edit" translate="label" type="select" sortOrder="330" showInDefault="1"
