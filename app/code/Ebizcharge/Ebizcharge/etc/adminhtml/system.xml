<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <resource>Ebizcharge_Ebizcharge::stores_configuration</resource>
            <group id="ebizcharge_ebizcharge" translate="label" type="text" sortOrder="10" showInDefault="1"
                   showInWebsite="1" showInStore="1">
                <comment>
                    <![CDATA[<div class="ebizcharge-payment-logo"></div><div class="ebizcharge-payment-text"><b>EBizCharge Payment Module</b> allows the processing of credit card payments via the <a target="_blank" target="_blank" title="EBizCharge Payment Gateway" href="http://www.ebizcharge.com/">EBizCharge Gateway</a>.
                    To set up the EBizCharge Payment Module, please contact <a target="_blank" title="EBizCharge Payment Gatway Support" href="http://www.ebizcharge.com/support/">EBizCharge Support</a>.</div>.]]></comment>
                <fieldset_css>complex ebizcharge-section</fieldset_css>
                <frontend_model>Ebizcharge\Ebizcharge\Block\Adminhtml\System\Config\Fieldset\Payment</frontend_model>

                <group id="how_it_works" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <comment><![CDATA[c]]></comment>
                    <fieldset_css>ebiz-how-it-works-config-sec</fieldset_css>
                    <frontend_model>Ebizcharge\Ebizcharge\Block\Adminhtml\System\Config\Fieldset\HowItWorks</frontend_model>
                </group>

                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1"
                       showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        <![CDATA[Select "Yes" to enable <b>EBizCharge Payment Module</b>. Select “No” to disable.]]></comment>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Payment Gateway Title</label>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>
                <!--<field id="pci_compliance_action_url" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>EBizCharge gateway SOAP API Url</label>
                    <comment><![CDATA[You need to provide a valid "EBizCharge payment Hub" SOAP API url e.g "https://soap.ebizcharge.net/eBizService.svc?wsdl".]]></comment>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>-->
                <field id="sourcekey" translate="label" type="password" sortOrder="40" showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>API Security Id</label>
                    <backend_model>Ebizcharge\Ebizcharge\Model\Config\Backend\Encrypted</backend_model>
<!--                    <frontend_model>Ebizcharge\Ebizcharge\Model\Config\Backend\Field\DecryptValue</frontend_model>-->
                    <validate>required-entry</validate>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>
                <field id="sourceid" translate="label" type="password" sortOrder="50" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>API User Id</label>
                    <backend_model>Ebizcharge\Ebizcharge\Model\Config\Backend\Encrypted</backend_model>
<!--                    <frontend_model>Ebizcharge\Ebizcharge\Model\Config\Backend\Field\DecryptValue</frontend_model>-->
                    <validate>required-entry</validate>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>
                <field id="sourcepin" translate="label" type="password" sortOrder="60" showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>API Password</label>
                    <backend_model>Ebizcharge\Ebizcharge\Model\Config\Backend\Encrypted</backend_model>
<!--                    <frontend_model>Ebizcharge\Ebizcharge\Model\Config\Backend\Field\DecryptValue</frontend_model>-->
                    <comment>
                        <![CDATA[Must match the password assigned to your Security Id. If no password is set, leave the field blank.]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>

                <field id="validatemerchantapi" translate="label comment tooltip" type="button"
                       sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Validate Keys</label>
                    <frontend_model>Ebizcharge\Ebizcharge\Block\Adminhtml\System\Config\ValidateMerchantButton</frontend_model>
                    <tooltip>
                        By clicking the button you can validate your API Keys with EBizCharge Payment Gateway
                    </tooltip>
                    <comment>
                        <![CDATA[Validate your API credentials with the <b>EBizCharge Payment Gateway</b> before proceeding. If there are any issues, contact <a target="_blank" title="EBizCharge Support" href="https://www.ebizcharge.com/support/">EBizCharge Support</a>. ]]></comment>

                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>

                <field id="envoirnment_prefix" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1"
                       showInStore="1" >
                    <label>Environment Prefix</label>
                    <comment>
                        <![CDATA[Add a prefix to Magento Customer ID to distinguish between your different Magento environments on the EBizCharge Gateway. Leaving it blank will add a default prefix of “Mag2” and will be saved as “Mag2-Your Magneto Customer ID” on EBizCharge Gateway. ]]></comment>
                    <backend_model>Ebizcharge\Ebizcharge\Model\Config\Backend\EnvironmentPrefix</backend_model>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>

                <field id="division_id" translate="label" type="hidden" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <!--                    <label>Division ID</label>-->
                    <!--<comment>
                        <![CDATA[Add a division id to distinguish assets (customers, items, orders, invoices, shipments etc.) between your multiple stores on the EBizCharge Payment Hub. Leaving it blank will add a default division ID of “Mag2” and will be saved as “Mag2-Your Magneto sync assets” on EBizCharge Gateway. ]]>
                    </comment>-->
                    <frontend_model>Ebizcharge\Ebizcharge\Block\Adminhtml\System\Config\Field\DivisionId</frontend_model>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>

