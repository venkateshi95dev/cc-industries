                    </depends>

                </field>
                <field id="recurring_frequency" translate="label" type="multiselect" sortOrder="280" showInDefault="1"
                       showInWebsite="1" showInStore="1" >
                    <label>Allowed Subscription Frequencies</label>
                    <source_model>Ebizcharge\Ebizcharge\Model\Source\RecurringFrequencyType</source_model>
                    <tooltip>
                        TWICE PER MONTH: Twice per month on the 1st and 15th of every month.
                        QUARTERLY: Every quarter on the 1st in January, April, July and October.
                        TWICE PER YEAR: Every 6 month on the 1st in January and July.
                    </tooltip>
                    <depends>
                        <field id="active">1</field>
                        <field id="recurring_payments">1</field>
                    </depends>
                </field>

                <field id="indefinite_recurring" translate="label" type="select" sortOrder="290" showInDefault="1"
