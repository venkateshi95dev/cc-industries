                    <label>Editing Orders</label>
                    <source_model>Ebizcharge\Ebizcharge\Model\Config\Source\VoidOrderYesno</source_model>
                    <comment>
                        <![CDATA["Magento native" voids the original order (and pre-auth) and create a new order upon editing.<br/>"Retain original" keeps the original order upon editing.]]></comment>
                    <depends>
                        <field id="active">1</field>
                    </depends>
                </field>

