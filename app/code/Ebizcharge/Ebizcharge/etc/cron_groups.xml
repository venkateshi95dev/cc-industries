<config>
    <!--CRON Group for Sync Payments with EBizCharge History-->
    <group id="ebizcharge_payments">
        <schedule_generate_every>2</schedule_generate_every>
        <schedule_ahead_for>4</schedule_ahead_for>
        <schedule_lifetime>2</schedule_lifetime>
        <history_cleanup_every>10</history_cleanup_every>
        <history_success_lifetime>60</history_success_lifetime>
        <history_failure_lifetime>600</history_failure_lifetime>
        <use_separate_process>1</use_separate_process>
    </group>
    <!--CRON Group for Sync Subscribed Orders-->
    <group id="ebizcharge_subscribed_orders" >
        <schedule_generate_every>1440</schedule_generate_every>
        <schedule_ahead_for>5040</schedule_ahead_for>
        <schedule_lifetime>120</schedule_lifetime>
        <history_cleanup_every>5040</history_cleanup_every>
        <history_success_lifetime>5040</history_success_lifetime>
        <history_failure_lifetime>5040</history_failure_lifetime>
        <use_separate_process>1</use_separate_process>
    </group>

    <!--CRON Group for Sync Low Stocks-->
    <group id="ebizcharge_low_stocks">
        <schedule_generate_every>50</schedule_generate_every>
        <schedule_ahead_for>5</schedule_ahead_for>
        <schedule_lifetime>60</schedule_lifetime>
        <history_cleanup_every>120</history_cleanup_every>
        <history_success_lifetime>130</history_success_lifetime>
        <history_failure_lifetime>140</history_failure_lifetime>
        <use_separate_process>1</use_separate_process>
    </group>

    <!--CRON Group for Sync Downloads-->
    <group id="ebizcharge_downloads">
        <schedule_generate_every>2</schedule_generate_every>
        <schedule_ahead_for>4</schedule_ahead_for>
        <schedule_lifetime>2</schedule_lifetime>
        <history_cleanup_every>10</history_cleanup_every>
        <history_success_lifetime>60</history_success_lifetime>
        <history_failure_lifetime>600</history_failure_lifetime>
        <use_separate_process>1</use_separate_process>
    </group>
    <!--CRON Group for Sync Uploads-->
    <group id="ebizcharge_uploads">
        <schedule_generate_every>2</schedule_generate_every>
        <schedule_ahead_for>4</schedule_ahead_for>
        <schedule_lifetime>2</schedule_lifetime>
        <history_cleanup_every>10</history_cleanup_every>
        <history_success_lifetime>60</history_success_lifetime>
        <history_failure_lifetime>600</history_failure_lifetime>
        <use_separate_process>1</use_separate_process>
    </group>

    <!--CRON Group for Sync Items Stock-->
    <group id="ebizcharge_sync_assets">
        <schedule_generate_every>2</schedule_generate_every>
        <schedule_ahead_for>4</schedule_ahead_for>
        <schedule_lifetime>2</schedule_lifetime>
        <history_cleanup_every>10</history_cleanup_every>
        <history_success_lifetime>60</history_success_lifetime>
        <history_failure_lifetime>600</history_failure_lifetime>
        <use_separate_process>1</use_separate_process>
    </group>

