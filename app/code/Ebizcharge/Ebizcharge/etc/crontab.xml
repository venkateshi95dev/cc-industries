<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="ebiz_recurring_order">
        <job name="ebiz_order_create" instance="Ebizcharge\Ebizcharge\Cron\CreateOrder" method="execute">
            <schedule>*/2 * * * *</schedule>
        </job>
    </group>
    <group id="ebiz_check_item_stock">
        <job name="ebiz_item_stock_check" instance="Ebizcharge\Ebizcharge\Cron\CheckItemStock" method="execute">
            <schedule>*/50 * * * *</schedule>
        </job>
    </group>

    <group id="ebizcharge_sync_downloads">
        <job name="sync_assets_cron_download_customers" instance="Ebizcharge\Ebizcharge\Cron\Downloads\SyncCustomers"
             method="execute">
            <schedule>* * * * *</schedule>
            <!-- <config_path>system/config/path</config_path>-->
        </job>
        <job name="sync_assets_cron_download_items" instance="Ebizcharge\Ebizcharge\Cron\Downloads\SyncItems"
             method="execute">
            <!--            <schedule>*/1 * * * *</schedule>-->
            <!-- <config_path>system/config/path</config_path>-->
        </job>
        <job name="sync_assets_cron_download_orders" instance="Ebizcharge\Ebizcharge\Cron\Downloads\SyncOrders"
             method="execute">
            <!--            <schedule>*/1 * * * *</schedule>-->
            <!-- <config_path>system/config/path</config_path>-->
        </job>
        <job name="sync_assets_cron_sync_items_stock" instance="Ebizcharge\Ebizcharge\Cron\Downloads\SyncOrders"
             method="execute">
            <!--            <schedule>*/1 * * * *</schedule>-->
            <!-- <config_path>system/config/path</config_path>-->
        </job>

    </group>
</config>
