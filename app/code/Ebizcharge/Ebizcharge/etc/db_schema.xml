        <column xsi:type="float" name="discount" nullable="false" default="0"
                comment="Ordered Discount"/>
        <column xsi:type="float" name="shipping_amount" nullable="true" default="0"
                comment="Shipping Amount"/>
        <column xsi:type="float" name="tax_amount" nullable="true" default="0"
                comment="Tax Amount"/>
        <column xsi:type="float" name="surcharge_amount" nullable="true" default="0"
                comment="Surcharge Amount"/>
        <column xsi:type="float" name="item_price" nullable="true" default="0"
                comment="Item Price"/>
        <column xsi:type="float" name="subtotal" nullable="true" default="0"
                comment="Subtotal"/>
        <column xsi:type="float" name="grand_total" nullable="true" default="0"
                comment="Grand Total"/>
