<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <!-- Adding new ebizcharge_recurring_dates Table-->
    <table name="ebizcharge_recurring_dates" resource="default" engine="innodb" comment="Ebizcharge recurring_dates">
        <column xsi:type="int" name="entity_id" nullable="false" identity="true"
                comment="entity_id"/>
        <column xsi:type="text" name="recurring_id" nullable="true"
                comment="recurring_id"/>
        <column xsi:type="datetime" name="recurring_date" nullable="true" comment="EBizCharge recurring date"/>
        <column xsi:type="int" name="customer_id" nullable="false" default="0"
                comment="Customer ID"/>
        <column xsi:type="int" name="store_id" nullable="true" default="0"
                comment="Store ID"/>
        <column xsi:type="float" name="ordered_qty" nullable="true" default="0"
                comment="Ordered Quantity"/>
        <column xsi:type="float" name="ordered_product_final_price" nullable="true" default="0"
                comment="Ordered Product Final Price"/>
        <column xsi:type="float" name="ordered_product_id" nullable="true" default="0"
                comment="Ordered Product Id"/>
        <column xsi:type="text" name="coupon_code"  nullable="true"
                comment="Coupon Code"/>
        <column xsi:type="float" name="discount" nullable="true" default="0"
                comment="Ordered Discount"/>
        <column xsi:type="float" name="amount" nullable="true" default="0"
                comment="Amount"/>
        <column xsi:type="float" name="shipping_amount" nullable="true" default="0"
                comment="Shipping Amount"/>
        <column xsi:type="float" name="tax_amount" nullable="true" default="0"
                comment="Tax Amount"/>
        <column xsi:type="float" name="surcharge_amount" nullable="true" default="0"
                comment="Surcharge Amount"/>
        <column xsi:type="float" name="item_price" nullable="true" default="0"
                comment="Item Price"/>
        <column xsi:type="float" name="subtotal" nullable="true" default="0"
                comment="Sub Total"/>
        <column xsi:type="float" name="grand_total" nullable="true" default="0"
                comment="Grand Total"/>
        <column xsi:type="int" name="ordered_status" nullable="false" default="0"
                comment="Ordered Status"/>
        <column xsi:type="text" name="remarks" nullable="true"
                comment="Recurred ordered remarks"/>
        <column xsi:type="timestamp" name="created_at" nullable="false"  on_update="true"
                comment="Created At"/>
        <column xsi:type="datetime" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="EBIZCHARGE_RECURRING_DATES_RECURRING_ID" indexType="btree">
            <column name="entity_id"/>
        </index>

    </table>

    <!-- Adding new ebizcharge_recurring_order Table-->

    <table name="ebizcharge_recurring_order" resource="default" engine="innodb" comment="Ebizcharge recurring_dates">
        <column xsi:type="int" name="entity_id" nullable="false" identity="true"
                comment="Entity Id"/>
        <column xsi:type="int" name="recurring_id" nullable="false" default="0"
                comment="recurring_id"/>
        <column xsi:type="text" name="recurring_date" nullable="true"
                comment="EBizCharge recurring date"/>
        <column xsi:type="text" name="rec_order_id" nullable="true"
                comment="EBizCharge recurring id"/>
        <column xsi:type="int" name="store_id" nullable="false" default="0"
                comment="Store ID"/>
        <column xsi:type="varchar" name="coupon_code" length="255" nullable="true" default="0"
                comment="Coupon Code"/>
        <column xsi:type="float" name="discount" nullable="false" default="0"
                comment="Ordered Discount"/>
        <column xsi:type="float" name="shipping_amount" nullable="true" default="0"
                comment="Shipping Amount"/>
        <column xsi:type="float" name="surcharge_amount" nullable="true" default="0"
                comment="Surcharge Amount"/>
        <column xsi:type="float" name="item_price" nullable="true" default="0"
                comment="Item Price"/>
        <column xsi:type="float" name="tax_amount" nullable="true" default="0"
                comment="Tax Amount"/>
        <column xsi:type="float" name="subtotal" nullable="true" default="0"
                comment="Subtotal"/>
        <column xsi:type="float" name="grand_total" nullable="true" default="0"
                comment="Grand Total"/>
        <column xsi:type="timestamp" name="created_date" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"
                comment="EBizCharge Order created date"/>
        <column xsi:type="text" name="order_date" nullable="true" comment="Order Date"/>
        <column xsi:type="int" name="status" nullable="false" default="0"
                comment="EBizCharge Order created status 0|1 "/>
        <column xsi:type="varchar" name="payment_method_name" nullable="true" length="255"
                comment="EBizCharge Payment Method Name"/>
        <column xsi:type="varchar" name="shipping_method" length="255" nullable="true"
                comment="EBizCharge Shipping Method Name"/>
        <column xsi:type="varchar" name="scheduled_payment_internal_id" length="255" nullable="true"
                comment="EBizCharge Payment Sheduled Reference Id"/>
        <column xsi:type="varchar" name="ebiz_recurring_payment_id" length="255" nullable="true"
                comment="EBizCharge Recurring Payment Id"/>
        <column xsi:type="varchar" name="ebiz_method_id" nullable="true" length="255"
                comment="EBizCharge Recurring Method Id"/>
        <column xsi:type="text" name="message" nullable="true" comment="message"/>
        <column xsi:type="varchar" name="order_entity_id" nullable="true" length="255"
                comment="Recurring order entity Id"/>
        <column xsi:type="datetime" name="created_at" nullable="false"  on_update="true"
                comment="Created At"/>
        <column xsi:type="datetime" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

    </table>

