                comment="Next Recurring"/>

        <column xsi:type="int" name="eb_rec_remaining" nullable="true" default="0"
                comment="Remaining Recurrings"/>
        <column xsi:type="text" name="eb_rec_due_dates" nullable="true"
                comment="Recurring Due Dates"/>
