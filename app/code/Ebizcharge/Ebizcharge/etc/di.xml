<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">



    <!-- Added command line Ebizcharge Commands Cli Framework for Developer(s) -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="ebizchargecli" xsi:type="object">Ebizcharge\Ebizcharge\Console\EbizchargeCommandsCli</item>
            </argument>
        </arguments>
    </type>

    <type name="Ebizcharge\Ebizcharge\Model\ShellCommand">
        <arguments>
            <argument name="shell" xsi:type="object">shellBackground</argument>
        </arguments>
    </type>
    <!-- Added EbizchargeHandler to handle the Logger file in the file system-->
    <type name="Ebizcharge\Ebizcharge\Logger\EbizchargeHandler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <!-- Added EbizchargeLogger to handle the Logs-->
    <type name="Ebizcharge\Ebizcharge\Logger\EbizchargeLogger">
        <arguments>
            <argument name="name" xsi:type="string">Ebizcharge</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Ebizcharge\Ebizcharge\Logger\EbizchargeHandler</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="payment/ebizcharge_ebizcharge/sourcekey" xsi:type="string">1</item>
                <item name="payment/ebizcharge_ebizcharge/sourceid" xsi:type="string">1</item>
                <item name="payment/ebizcharge_ebizcharge/sourcepin" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="payment_history_listing_data_source" xsi:type="string">
                    Ebizcharge\Ebizcharge\Model\ResourceModel\PaymentHistory\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>
    <!--end of listing data source for payment history grid-->


    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="recurrion_listing_data_source" xsi:type="string">
                    Ebizcharge\Ebizcharge\Model\ResourceModel\Recurring\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Ebizcharge\Ebizcharge\Model\ResourceModel\Recurring\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ebizcharge_recurring</argument>
            <argument name="resourceModel" xsi:type="string">
                Ebizcharge\Ebizcharge\Model\ResourceModel\Recurring
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="future_list_data_source" xsi:type="string">
                    Ebizcharge\Ebizcharge\Model\ResourceModel\FutureSubscription\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Ebizcharge\Ebizcharge\Model\ResourceModel\FutureSubscription\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ebizcharge_recurring_dates</argument>
            <argument name="resourceModel" xsi:type="string">
                Ebizcharge\Ebizcharge\Model\ResourceModel\FutureSubscription
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="order_list_data_source" xsi:type="string">
                    Ebizcharge\Ebizcharge\Model\ResourceModel\OrderSubscription\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Ebizcharge\Ebizcharge\Model\ResourceModel\OrderSubscription\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ebizcharge_recurring_order</argument>
            <argument name="resourceModel" xsi:type="string">
                Ebizcharge\Ebizcharge\Model\ResourceModel\OrderSubscription
            </argument>
        </arguments>
    </type>
    <type name="Magento\Checkout\Model\DefaultConfigProvider">
        <plugin name="checkout-summary-product-attribute"
                type="Ebizcharge\Ebizcharge\Plugin\Checkout\Model\DefaultConfigProvider"/>
    </type>

    <type name="Magento\Sales\Block\Adminhtml\Order\View\Items\Renderer\DefaultRenderer">
        <plugin name="subscription_details_sales_order_view"
                type="Ebizcharge\Ebizcharge\Plugin\Sales\Order\View\SubscriptionDetails"/>
    </type>

    <!--Order Grid Colleciton Override-->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="sales_order_grid_data_source"
                      xsi:type="string">Ebizcharge\Ebizcharge\Model\ResourceModel\Order\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Ebizcharge\Ebizcharge\Model\ResourceModel\Order\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">sales_order_grid</argument>
            <argument name="resourceModel" xsi:type="string">Magento\Sales\Model\ResourceModel\Order</argument>
        </arguments>
    </type>

    <!-- Invoice creation Surcharge -->
    <type name="Magento\Sales\Model\Service\InvoiceService">
        <plugin name="prepare_invoice_after"
                type="Ebizcharge\Ebizcharge\Plugin\Sales\Model\Service\InvoiceSurcharge"/>
    </type>
    <type name="Magento\Checkout\Model\Cart">
        <plugin name="ebizcharge_ebizcharge_before_cart_to_plugin" type="Ebizcharge\Ebizcharge\Plugin\Checkout\Cart\BeforAddToCartItemPlugin" />
    </type>

    <type name="Magento\Quote\Api\CartRepositoryInterface">
        <plugin name="ebizcharge_ebizcharge_update_cart_items_qty" type="Ebizcharge\Ebizcharge\Plugin\Checkout\Cart\UpdateCartItems" />
    </type>

    <type name="Magento\Sales\Model\AdminOrder\Create">
        <plugin name="ebizcharge_ebizcharge_update_address_region" type="Ebizcharge\Ebizcharge\Plugin\Sales\Order\AdminOrder\CreateOrder\UpdateAddressRegion" />
    </type>

    <type name="Magento\Checkout\Model\Cart">
        <plugin name="ebizcharge_ebizcharge_cart_plugin" type="Ebizcharge\Ebizcharge\Plugin\Checkout\Cart\AddProductToCartPlugin" />
    </type>
    <type name="Magento\Checkout\CustomerData\Cart">
        <plugin name="ebizcharge_ebizcharge_mini_cart_rearrange_items_plugin" type="Ebizcharge\Ebizcharge\Plugin\Checkout\Cart\ReArrange\ArrangeMiniCartItemsPlugin" />
    </type>
    <type name="Magento\Checkout\Block\Cart">
        <plugin name="ebizcharge_ebizcharge_cart_rearrange_items_plugin" type="Ebizcharge\Ebizcharge\Plugin\Checkout\Cart\ReArrange\ArrangeMiniCartItemsPlugin" />
    </type>

    <type name="Magento\Tax\Block\Item\Price\Renderer">
        <plugin name="ebizcharge_ebizcharge_set_subscription_price_plugin" type="Ebizcharge\Ebizcharge\Plugin\Checkout\Cart\ReArrange\Recurring\AfterGetItemPlugin" sortOrder="1" />
    </type>
    <type name="Magento\Shipping\Model\Shipping">
        <plugin name="ebizcharge_ebizcharge_skip_subscribed_product_shipping_plugin" type="Ebizcharge\Ebizcharge\Plugin\Checkout\Cart\ReArrange\Recurring\AfterCollectCarrierRatesPlugin" sortOrder="1"/>
    </type>
    <type name="Magento\Sales\Block\Adminhtml\Order\Create\Totals">
        <plugin name="ebizcharge_ebizcharge_surcharge_create_order_totals_plugin" type="Ebizcharge\Ebizcharge\Plugin\Sales\Order\AdminOrder\CreateOrder\SurchargeTotals" sortOrder="10" />
    </type>

    <type name="Magento\Sales\Model\Order\Creditmemo">
        <plugin name="ebizcharge_ebizcharge_update_creditmemo_totals" type="Ebizcharge\Ebizcharge\Plugin\Sales\Model\Order\CreditmemoPlugin" />
    </type>
    <type name="Magento\ReCaptchaValidation\Model\Validator">
        <plugin name="ebizcharge_ebizcharge_rest_webapi_recaptcha_validation" type="Ebizcharge\Ebizcharge\Plugin\Checkout\Model\RestValidationPlugin" sortOrder="1" />
    </type>

    <type name="Magento\Payment\Model\PaymentMethodList">
        <plugin name="ebizcharge_ebizcharge_rest_webapi_payment_method_visiblity" type="Ebizcharge\Ebizcharge\Plugin\Checkout\Model\RestValidationPlugin" sortOrder="1" />
    </type>

    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="ebizcharge_ebizcharge_after_order_save_after" type="Ebizcharge\Ebizcharge\Plugin\Checkout\Model\OrderRepositoryPlugin" sortOrder="1" />
    </type>
    <type name="Amasty\GiftCardAccount\Model\GiftCardExtension\Order\Handlers\SaveHandler">
        <plugin name="ebizcharge_ebizcharge_savehandler_before_plugin"
                type="Ebizcharge\Ebizcharge\Plugin\Checkout\Model\SaveHandlerPlugin"
                sortOrder="10"/>
    </type>
    <type name="Magento\Checkout\Block\Checkout\LayoutProcessorInterface">
        <plugin name="ebizcharge_ebizcharge_layoutprocessor_plugin_after"
                type="Ebizcharge\Ebizcharge\Plugin\Checkout\Model\LayoutProcessorPlugin"
                sortOrder="10"/>
    </type>

    <virtualType name="Ebizcharge\Ebizcharge\Model\ResourceModel\PaymentHistory\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">ebizcharge_recurring_payment_history</argument>
            <argument name="resourceModel" xsi:type="string">
                Ebizcharge\Ebizcharge\Model\ResourceModel\PaymentHistory\Collection
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="EbizchargeFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Ebizcharge\Ebizcharge\Api\Data\PaymentInterface::CODE</argument>
            <argument name="valueHandlerPool" xsi:type="object">EbizchargeValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">EbizchargeValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">EbizchargeCommandPool</argument>
            <argument name="formBlockType" xsi:type="string">
                Ebizcharge\Ebizcharge\Block\Order\MultiShipping\PaymentForm
            </argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
        </arguments>
    </virtualType>

    <virtualType name="EbizchargeValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">EbizchargeConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="EbizchargeConfigValueHandler" type="Ebizcharge\Ebizcharge\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">EbizchargeConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="EbizchargeConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Ebizcharge\Ebizcharge\Api\Data\PaymentInterface::CODE</argument>
        </arguments>
    </virtualType>

    <!-- Ebizcharge Country validators infrastructure -->
    <virtualType name="EbizchargeCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Config\Config</argument>
        </arguments>
    </virtualType>
    <virtualType name="EbizchargeValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">EbizchargeCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <!-- End of Ebizcharge validators infrastructure -->

    <virtualType name="EbizchargeCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="authorize" xsi:type="string">EbizchargeAuthorizeCommand</item>
                <item name="capture" xsi:type="string">EbizchargeCaptureCommand</item>
                <item name="sale" xsi:type="string">EbizchargeSaleCommand</item>
                <item name="void" xsi:type="string">EbizchargeVoidCommand</item>
                <item name="cancel" xsi:type="string">EbizchargeCancelCommand</item>
                <item name="refund" xsi:type="string">EbizchargeRefundCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="EbizchargeAuthorizeCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">EbizchargeAuthorizeRequest</argument>
            <argument name="transferFactory" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Http\TransferFactory
            </argument>
            <argument name="client" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Http\Client\TransactionAuthorize
            </argument>
            <argument name="handler" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Response\TransactionIdHandler
            </argument>
            <argument name="validator" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Validator\ResponseValidator
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="EbizchargeAuthorizeRequest" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="authorize" xsi:type="string">Ebizcharge\Ebizcharge\Gateway\Request\AuthorizeDataBuilder
                </item>
                <item name="store" xsi:type="string">Ebizcharge\Ebizcharge\Gateway\Request\StoreConfigBuilder</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="EbizchargeCaptureCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">EbizchargeCaptureRequest</argument>
            <argument name="transferFactory" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Http\TransferFactory
            </argument>
            <argument name="client" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Http\Client\TransactionCaptureSale
            </argument>
            <argument name="handler" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Response\TransactionIdHandler
            </argument>
            <argument name="validator" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Validator\ResponseValidator
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="EbizchargeCaptureRequest" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="authorize" xsi:type="string">Ebizcharge\Ebizcharge\Gateway\Request\AuthorizeDataBuilder
                </item>
                <item name="store" xsi:type="string">Ebizcharge\Ebizcharge\Gateway\Request\StoreConfigBuilder</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="EbizchargeSaleCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">EbizchargeSaleRequest</argument>
            <argument name="transferFactory" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Http\TransferFactory
            </argument>
            <argument name="client" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Http\Client\TransactionCaptureSale
            </argument>
            <argument name="handler" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Response\TransactionIdHandler
            </argument>
            <argument name="validator" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Validator\ResponseValidator
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="EbizchargeSaleRequest" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="authorize" xsi:type="string">Ebizcharge\Ebizcharge\Gateway\Request\AuthorizeDataBuilder
                </item>
                <item name="store" xsi:type="string">Ebizcharge\Ebizcharge\Gateway\Request\StoreConfigBuilder</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="EbizchargeVoidCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="client" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Http\Client\TransactionVoid
            </argument>
            <argument name="requestBuilder" xsi:type="object">EbizchargeVoidRequestBuilder</argument>
            <argument name="handler" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Response\TransactionIdHandler
            </argument>
