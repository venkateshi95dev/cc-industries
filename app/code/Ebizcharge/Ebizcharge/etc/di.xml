            <argument name="validator" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Validator\ResponseValidator
            </argument>
            <argument name="transferFactory" xsi:type="object">Ebizcharge\Ebizcharge\Gateway\Http\TransferFactory
