                <item name="refund" xsi:type="string">Ebizcharge\Ebizcharge\Gateway\Request\RefundDataBuilder</item>
                <item name="store" xsi:type="string">Ebizcharge\Ebizcharge\Gateway\Request\StoreConfigBuilder</item>
            </argument>
        </arguments>
    </virtualType>


