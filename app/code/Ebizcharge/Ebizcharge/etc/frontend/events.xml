<config xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
        xsi:noNamespaceSchemaLocation='urn:magento:framework/Event/etc/events.xsd'>
<!--    <event name="customer_register_success">-->
<!--        <observer name="Ebizcharge_Ebizcharge_AddCustomer" instance="Ebizcharge\Ebizcharge\Observer\AddCustomer"/>-->
<!--    </event>-->
    <event name="checkout_onepage_controller_success_action">
        <observer name="Ebizcharge_Ebizcharge_AddOrder" instance="Ebizcharge\Ebizcharge\Observer\AddOrder"/>
        <observer name="Ebizcharge_Ebizcharge_AddInvoice" instance="Ebizcharge\Ebizcharge\Observer\AddInvoice"/>
    </event>

    <event name="controller_action_predispatch_checkout_cart_add">
        <observer name="Ebizcharge_Ebizcharge_checkout_cart_add" instance="Ebizcharge\Ebizcharge\Observer\Cart\BeforeAddItemToCartObserver"/>
    </event>

    <event name="checkout_cart_update_items_after">
        <observer name="Ebizcharge_Ebizcharge_checkout_cart_update_after" instance="Ebizcharge\Ebizcharge\Observer\Cart\AfterItemUpdatedToCartObserver"/>
    </event>
    <event name="sales_order_place_after">
        <observer name="ebizcharge_place_order_after" instance="Ebizcharge\Ebizcharge\Observer\Order\OrderPlaceAfter"/>
    </event>


</config>
