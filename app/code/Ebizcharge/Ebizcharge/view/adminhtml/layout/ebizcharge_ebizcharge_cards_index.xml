                <argument name="add_button_url" xsi:type="const">
                    Ebizcharge\Ebizcharge\Block\Adminhtml\CustomerEdit\Tab\View\PaymentMethods::CARD_ADD_PATH
                </argument>
            </arguments>
        </block>
    </container>
