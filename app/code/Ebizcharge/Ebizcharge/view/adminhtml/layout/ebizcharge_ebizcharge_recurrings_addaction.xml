<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <referenceBlock name="page.title">
        <action method="setPageTitle">
            <argument name="title" xsi:type="string">Add Subscription</argument>
        </action>
    </referenceBlock>
    <body>
        <referenceContainer name="content">
            <block class="Ebizcharge\Ebizcharge\Block\Adminhtml\Recurring\Recurrings" name="ebizcharge.recurrings.add" ifconfig="payment/ebizcharge_ebizcharge/active" template="Ebizcharge_Ebizcharge::recurring/add_recurrings.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Magento\Customer\ViewModel\Address</argument>
                </arguments>
                <block class="Ebizcharge\Ebizcharge\Block\Adminhtml\Recurring\Recurrings" name="ebizcharge.recurrings.payments" ifconfig="payment/ebizcharge_ebizcharge/active" template="Ebizcharge_Ebizcharge::recurring/payment_panels.phtml">
                    <arguments>
                        <argument name="view_model" xsi:type="object">Magento\Customer\ViewModel\Address</argument>
                    </arguments>
                    <block class="Ebizcharge\Ebizcharge\Block\Adminhtml\Recurring\Recurrings"
                           name="ebizcharge.recurrings.add.cvv.avs.warnings"
                           ifconfig="payment/ebizcharge_ebizcharge/active"
                           template="Ebizcharge_Ebizcharge::customer/account/avs_cvv_warnings.phtml" />

                </block>
            </block>
        </referenceContainer>

        <!-- How It Works -->
        <referenceContainer name="header.inner.left">
            <block class="Ebizcharge\Ebizcharge\Block\Adminhtml\HowItWorks\HowItWorks"
                   name="ebizcharge.how.it.works"
                   template="Ebizcharge_Ebizcharge::howItWorks/link-with-tooltip.phtml"
                   ifconfig="payment/ebizcharge_ebizcharge/active"/>
        </referenceContainer>
    </body>
</page>
