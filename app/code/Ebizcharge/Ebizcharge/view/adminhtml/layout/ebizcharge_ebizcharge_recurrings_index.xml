/**
* Declares the block and sets the template for the Cards/ListAction controller.
* The name of this file uses the following pattern: routeId_controller_action.xml
*/
-->

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <referenceBlock name="page.title">
        <action method="setPageTitle">
            <argument name="title" xsi:type="string">Subscriptions</argument>
        </action>
    </referenceBlock>
    <body>
        <referenceContainer name="content">
            <uiComponent name="recurrion_listing"/>
        </referenceContainer>

        <!-- How It Works -->
        <referenceContainer name="header.inner.left">
            <block class="Ebizcharge\Ebizcharge\Block\Adminhtml\HowItWorks\HowItWorks"
                   name="ebizcharge.how.it.works"
                   template="Ebizcharge_Ebizcharge::howItWorks/link-with-tooltip.phtml"
                   ifconfig="payment/ebizcharge_ebizcharge/active"/>
        </referenceContainer>
    </body>
</page>
