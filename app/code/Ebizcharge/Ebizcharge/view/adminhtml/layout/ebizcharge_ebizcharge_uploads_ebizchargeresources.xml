<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="editor"/>
    <body>
        <referenceContainer name="left">
            <block class="Ebizcharge\Ebizcharge\Block\Adminhtml\SyncAssets\Tabs"
                   name="upload_resources_tabs"
                   ifconfig="payment/ebizcharge_ebizcharge/uploadeconnect">
                <arguments>
                    <argument name="sync_action" xsi:type="string">Upload</argument>
                    <argument name="sync_from_to" xsi:type="string">to</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Ebizcharge\Ebizcharge\Block\Adminhtml\SyncAssets\SyncResources"
                   name="ebizcharge.sync.resources"
                   template="Ebizcharge_Ebizcharge::syncAssets/sync_resources_store_switcher.phtml"
                   ifconfig="payment/ebizcharge_ebizcharge/uploadeconnect"/>

            <block name="ebizcharge_upload_resources_container"
                   template="Ebizcharge_Ebizcharge::syncAssets/sync_ebizcharge_resources.phtml"
                   ifconfig="payment/ebizcharge_ebizcharge/uploadeconnect">
                <arguments>
                    <argument name="sync_action" xsi:type="string">Upload</argument>
                    <argument name="sync_from_to" xsi:type="string">to</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!-- How It Works -->
        <referenceContainer name="header.inner.left">
            <block class="Ebizcharge\Ebizcharge\Block\Adminhtml\HowItWorks\HowItWorks"
                   name="ebizcharge.how.it.works"
                   template="Ebizcharge_Ebizcharge::howItWorks/link-with-tooltip.phtml"
                   ifconfig="payment/ebizcharge_ebizcharge/active"/>
        </referenceContainer>
    </body>
</page>
