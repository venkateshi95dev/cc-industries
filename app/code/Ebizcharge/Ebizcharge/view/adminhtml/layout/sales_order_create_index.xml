<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>

        <referenceBlock name="order_create_billing_form">
            <action method="setMethodFormTemplate"
                    ifconfig="payment/ebizcharge_ebizcharge/active">
                <argument name="method" xsi:type="const">Ebizcharge\Ebizcharge\Api\Data\PaymentInterface::CODE</argument>
                <argument name="template" xsi:type="string">
                    Ebizcharge_Ebizcharge::order/create/form/payment_method_form.phtml
                </argument>
            </action>
        </referenceBlock>

        <referenceBlock name="items_grid">
            <action method="setTemplate"
                    ifconfig="payment/ebizcharge_ebizcharge/active">
                <argument name="template" xsi:type="string">Ebizcharge_Ebizcharge::order/create/items/grid.phtml
                </argument>
            </action>
            <block class="Ebizcharge\Ebizcharge\Block\Adminhtml\Recurring\Recurrings"
                   name="sales.order.items.renderers.default.subscription"
                   ifconfig="payment/ebizcharge_ebizcharge/active"
                   template="Ebizcharge_Ebizcharge::order/create/items/subscription.phtml"/>

        </referenceBlock>

        <referenceContainer name="content">
            <block class="Ebizcharge\Ebizcharge\Block\Adminhtml\Recurring\Recurrings"
                   name="ebizcharge.recurrings.add.cvv.avs.warnings"
                   ifconfig="payment/ebizcharge_ebizcharge/active"
                   template="Ebizcharge_Ebizcharge::customer/account/avs_cvv_warnings.phtml"/>
            <block name="ebizcharge.validation-rules-js"
                   ifconfig="payment/ebizcharge_ebizcharge/active"
                   template="Ebizcharge_Ebizcharge::validation/rules.phtml"/>
        </referenceContainer>

    </body>
</page>
