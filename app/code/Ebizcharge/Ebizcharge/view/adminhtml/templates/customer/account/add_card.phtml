use Ebizcharge\Ebizcharge\Block\Adminhtml\Recurring\Recurrings;

/**
 * @var Recurrings $block
 */

$_code = 'payment';
$action = $block->getAction();
$_ccExpMonth = $_ccExpYear = '';

/**
 * is Very Card Cod Required
 */
$cardCodeRequired = $block->isCardCodeRequiredForAdmin();
$cardCodeRequiredForNewCard = $cardCodeRequired['new_card'];
$cardCodeRequiredForSavedCard = $cardCodeRequired['saved_card'];

$requiredCvvClass = "";
$validateNumber = "";

/**
 * In case if Saved card
 */
if ($cardCodeRequiredForNewCard) {
    $requiredCvvClass = "_required";
    $validateNumber = "'required-number':true";
}

$secondarySort = true;

/**
 * if in case of Edit the Credit Card
 */
if ($action == 'edit') {

    /** in case of if
     * Saved Card already
     */
    if ($cardCodeRequiredForSavedCard) {
        $requiredCvvClass = "_required";
        $validateNumber = "'required-number':true";
    } else {
        $requiredCvvClass = "";
        $validateNumber = "";
    }

    /** @var  $paymentMethodProfileData */
    $paymentMethodProfileData = $block->getCustomerPaymentMethodProfile();
    // var_dump("<pre>", $paymentMethodProfileData);exit;

    $paymentMethodType = $block->getPaymentMethodType();
    $paymentMethodJsonType = $block->getPaymentMethodJsonType();
    $methodId = $block->getPaymentMethodId();
    $methodName = $block->getPaymentMethodNameJsonString();
    $_ccExpMonth = $block->getPaymentMethodExpMonth();
    $_ccExpYear = $block->getPaymentMethodExpYear();
    $createdAt = $block->getPaymentMethodCreatedAt();
    $modifiedAt = $block->getPaymentMethodModifiedAt();
    $cardNumber = $block->getPaymentMethodCardNumber();
    $avsStreet = $block->getPaymentMethodAvsStreet();
    $avsZip = $block->getPaymentMethodAvsZip();
    $cardHolder = $block->getPaymentMethodAccountHolderName();
    $secondarySort = $block->getPaymentMethodProfileSecondarySort();
}
