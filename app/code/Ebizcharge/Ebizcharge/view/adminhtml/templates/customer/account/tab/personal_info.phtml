    </table>

    <div class="personal-info right-panel">
        <address >
            <strong><?= $block->escapeHtml(__('Default Billing Address')) ?></strong><br/>
            <?= $block->escapeHtml($block->getBillingAddressHtml(), $allowedAddressHtmlTags) ?>
        </address>
        <address >
            <strong><?= $block->escapeHtml(__('Default Shipping Address')) ?></strong><br/>
            <?= $block->escapeHtml($block->getShippingAddressHtml(), $allowedAddressHtmlTags) ?>
        </address>
    </div>
</div>




