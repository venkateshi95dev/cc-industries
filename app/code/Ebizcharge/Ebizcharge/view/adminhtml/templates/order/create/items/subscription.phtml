declare(strict_types=1);

use Ebizcharge\Ebizcharge\Block\Adminhtml\Items\Renderer\DefaultRenderer;
use Ebizcharge\Ebizcharge\Model\Recurring;

/**
 * @var  $block DefaultRenderer
 */
$orderItem = $block->getItem();
$itemId = $orderItem->getId();
$productId = $orderItem->getProductId();

/**
 * @var $orderItemOptions
 */
$orderItemOptions = $orderItem->getBuyRequest();
$recurrings = $orderItemOptions->getRecurring();
$qty = $orderItemOptions->getQty();
$isRecurringIndefinite = isset($recurrings["rec_indefinitely"]) ? $recurrings["rec_indefinitely"] : 0;
$isRecurringIndefinite = $isRecurringIndefinite && $isRecurringIndefinite > 0;

//if ($recurrings && count($recurrings) > 0) {
if (isset($recurrings['rec_frequency']) && !empty($recurrings['rec_frequency'])) { ?>
    <br/>
    <div class="subscribe subscribed-item">
        <div class="label">&#10026;
            <b> <?= /* @noEscape */
                __('Subscribed'); ?></b></div>
        <div class="label"> <?= /* @noEscape */
            __('Frequency:'); ?><b> <?= /* @noEscape */
                $recurrings['rec_frequency']; ?></b></div>
        <div class="label"> <?= /* @noEscape */
            __('Qty Subscribed:'); ?><b> <?= /* @noEscape */
                $qty; ?></b></div>
        <div class="label"> <?= /* @noEscape */
            __('Start :'); ?><b> <?= /* @noEscape */
                $recurrings['sdate']; ?></b></div>
        <?php
        if ($isRecurringIndefinite) { ?>
            <div class="label">
                <b><?= /* @noEscape */
                    __("Indefinite(" . Recurring::DEFAULT_INDEFINITE_RECURRING_LIMIT . " Year)"); ?></b>
            </div>
        <?php } else { ?>
            <div class="label"> <?= /* @noEscape */
                __('End :'); ?><b> <?= /* @noEscape */ $recurrings['edate']; ?></b></div>

        <?php } ?>

    </div>
<?php } ?>
