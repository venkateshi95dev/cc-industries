$scriptString = <<<script
require([
    "jquery",
    "mage/calendar"
], function($, calendar) {

        let endDatePanel = $('#end_date_panel_$itemId');
        let recIndefinitely = $recurringIndefinite;

        if(recIndefinitely){
                endDatePanel.hide();
        }
                $('.action-close').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            //closeDialog(); // Replace with actual logic
            console.log(e.target.id);
         });

        $('#start_date_$itemId, #end_date_$itemId').calendar({
            buttonText: '',
            minDate: '+1d',
            dateFormat: 'Y-mm-dd',
            showOn: 'both',
            onSelect: function(date) {
                if (this.id === 'end_date_$itemId') {

                     $("#end_date_$itemId").datepicker('option', date, date);

                }
            },
            beforeShow: function(){
                 $(this).attr("autocomplete", "off");
            }
        });

         $('#rec_activate_$itemId').on('click', function () {

            if(!checkPrevFormFilled()) {
                    return false
            }

            let disabled = true;

            if ($('#rec_activate_$itemId').is(':checked') == true) {
                disabled = false;

            }

           toggleSubscriptionForm(disabled);

        });

        $('.super-attribute-select').on('click', function(){
            if(!checkPrevFormFilled() && $('#rec_activate_$itemId').is(':checked') == true) {
                 $("#rec_activate_$itemId").trigger("click");

                 /** disable subscription fields */
                 toggleSubscriptionForm(true);
            }

        });

        /** check if user has selected a product variation */
        function checkPrevFormFilled() {

            let fieldsCount = jQuery('.super-attribute-select').length;

            /** form has no parent fields */
            if(fieldsCount < 1) {
                return true;
            }

            let lastFieldValue = jQuery('.super-attribute-select').last().val();

            if(lastFieldValue == null || lastFieldValue == '') {
                    return false
            }
            return true;
        }

        /** Enable disable subscription form */
        function toggleSubscriptionForm(disabled) {
            $('#rec_frequency_$itemId, #start_date_$itemId, #end_date_$itemId, #rec_indefinite_$itemId')
            .prop( "disabled", disabled );
        }

        $('#rec_indefinite_$itemId').on('click', function () {

            let disabled = false;

            if ($('#rec_indefinite_$itemId').is(':checked') == true) {
                disabled = true;
                endDatePanel.hide();
            } else {
                endDatePanel.show();
            }

           $('#end_date_$itemId').prop( "disabled", disabled );

        });
});
script;
