declare(strict_types=1);

/**
 * @var $block \Ebizcharge\Ebizcharge\Block\Adminhtml\SyncAssets\Logs\View
 */

$logMessages = $block->getLogs();
?>
<div class="admin__data-grid-wrap admin__data-grid-wrap-static">

    <table class="data-grid">
        <thead>
            <tr>
                <th data-sort="date_added" data-direction="asc" class="data-grid-th">
                    <span><?= /* @noEscape */ __('Date Added') ?></span>
                </th>
                <th data-sort="title" data-direction="asc" class="data-grid-th">
                    <span><?= /* @noEscape */ __('Message') ?></span>
                </th>
            </tr>
        </thead>
        <tbody>
        <?php if (is_array($logMessages) && count($logMessages) > 0): ?>
            <?php foreach ($logMessages as $message):?>
                <tr data-role="row" title="#" class="even _clickable">
                    <td data-column="date_added" class="col-date col-date_added">
                        <?= /* @noEscape */ $message[0] ?? ''?>
                    </td>
                    <td data-column="title" class="col-title">
                        <?= /* @noEscape */ $message[1] ?? ''?>
                    </td>
                </tr>
            <?php endforeach;?>
        <?php endif;?>
        </tbody>
    </table>
</div>
