declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/**
 * Sync Resources Block
 *
 * @var Template $block
 */

$syncAction = $block->getSyncAction();

$stores = $block->getAllStores();
$websites = $block->getAllWebsites();

if (count($stores) > 0) {
    ?>
    <div id="store-switcher" style="text-align: right; ">
        <label>Select Store :
            <select id="storeChaner">
                <option value="0"><?= /* @noEscape */ __('Default Config') ?></option>
                <?php
                foreach ($stores as $store) {
                    ?>
                    <option value="<?= /* @noEscape */ $store->getCode(); ?>">
                        <?= /* @noEscape */ $store->getName(); ?>
                    </option>
                <?php } ?>
            </select>
        </label>
    </div>
<?php } ?>
