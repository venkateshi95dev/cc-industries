<?php // phpcs:ignore ?>
<script type="text/javascript">
    //<![CDATA[
    function <?= $block->escapeHtml($block->getButtonFunction()) ?>_click() {
        new Ajax.Request('<?= $block->escapeUrl($block->getAjaxUrl()) ?>', {
            method: 'get',
            onSuccess: function (transport) {
                //alert(transport.responseText);
                if (transport.responseText) {
                    $('messages').update("");
                    $('messages').update(transport.responseText);
                } else {
                    //location.reload();
                    location = location
                }
            },
            onFailure: function (transport) {
                var html = '<ul class="messages"><li class="error-msg"><ul>' +
                    '<li>Error running request.</li></ul></li></ul>';
                $('page.messages').update("");
                $('page.messages').update(html);
            }
        });
    }

    //]]>
</script>

<?= /* @noEscape */ $block->getButtonHtml(); ?>
