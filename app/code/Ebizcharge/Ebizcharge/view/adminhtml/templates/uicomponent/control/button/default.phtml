declare(strict_types=1);

/**
 * @var Button $block
 * @var Escaper $escaper
 */

use Ebizcharge\Ebizcharge\Override\Component\Control\Button;
use Magento\Framework\Escaper;
?>

<?php if ($block->ifEbizOrderGrid()) { ?>
    <?= /* @noEscape */ $block->getCalendarCss() ?>
    <div class="field date-time-picker">
        <label >
            <span><?= $block->escapeHtml($block->getLabel()) ?> : </span>
        </label>
        <?= /* @noEscape */ $block->getDateInput(); ?>
    </div>
<?php } else { ?>
    <?= /* @noEscape */ $block->getBeforeHtml() ?>
    <button <?= /* @noEscape */
    $block->getAttributesHtml(), /* @noEscape */
    $block->getUiId() ?>>
        <span><?= $escaper->escapeHtml($block->getLabel()) ?></span>
    </button>
    <?= /* @noEscape */ $block->getAfterHtml() ?>
<?php } ?>
