        <filterSearch name="fulltext">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="placeholder" xsi:type="string">Search by Customer Name, Customer Email </item>
                </item>
            </argument>
        </filterSearch>
        <paging name="listing_paging">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="storageConfig" xsi:type="array">
                        <item name="provider" xsi:type="string">order_listing.order_listing.listing_top.bookmarks</item>
                        <item name="namespace" xsi:type="string">current.paging</item>
                    </item>
                    <item name="selectProvider" xsi:type="string">order_listing.order_listing.order_grid_columns.ids
                    </item>
                </item>
            </argument>
        </paging>
    </listingToolbar>

    <!-- from here we'll add columns of grid list -->
    <columns name="order_grid_columns">
        <selectionsColumn name="ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">entity_id</item>
                    <item name="sorting" xsi:type="string">desc</item>
                    <item name="sortOrder" xsi:type="number">0</item>
                    <item name="sortable" xsi:type="boolean">true</item>

                </item>
            </argument>
        </selectionsColumn>
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Entity ID</label>
                <sorting>desc</sorting>
                <visible>false</visible>
            </settings>
        </column>
        <column name="rec_order_id" class="Ebizcharge\Ebizcharge\Ui\Component\Listing\Column\OrderLink">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="label" xsi:type="string" translate="true">Order IDs</item>
                    <item name="sortable" xsi:type="boolean">true</item>
                    <item name="filter" xsi:type="string">text</item>
                </item>
            </argument>
        </column>
        <column name="customer_name" class="Ebizcharge\Ebizcharge\Ui\Component\Listing\Column\PaymentHistory\CustomerNameRenderer">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="label" xsi:type="string" translate="true">Customer Name</item>
                    <item name="sortable" xsi:type="boolean">true</item>
<!--                    <item name="filter" xsi:type="string">text</item>-->
<!--                    <item name="dataType" xsi:type="string">text</item>-->
                </item>
            </argument>
        </column>
        <column name="email" class="Ebizcharge\Ebizcharge\Ui\Component\Listing\Column\PaymentHistory\GridIcons">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Customer Email</item>
                    <item name="sortable" xsi:type="boolean">true</item>
                </item>
            </argument>
        </column>


        <column name="mage_item_name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Product</item>
                    <item name="sortable" xsi:type="boolean">true</item>
                    <item name="filter" xsi:type="string">text</item>
                </item>
            </argument>
        </column>
        <column name="eb_rec_frequency">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Ebizcharge\Ebizcharge\Model\Source\RecurringFrequencyType</item>
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">select</item>
                    <item name="label" xsi:type="string" translate="true">Frequency</item>
                    <item name="editor" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/select</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="sortable" xsi:type="boolean">true</item>
                </item>
            </argument>
        </column>
        <column name="shipping_method" class="Ebizcharge\Ebizcharge\Ui\Component\Listing\Column\SubscriptionOrders\ShippingMethod">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Shipping Method</item>
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="sortable" xsi:type="boolean">true</item>
                    <item name="editor" xsi:type="string">text</item>
                    <item name="filter" xsi:type="string">text</item>
                    <item name="dataType" xsi:type="string">text</item>
                </item>
            </argument>
        </column>
        <column name="payment_method_name" class="Ebizcharge\Ebizcharge\Ui\Component\Listing\Column\SubscriptionOrders\PaymentMethod">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Payment Method</item>
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="sortable" xsi:type="boolean">true</item>
                    <item name="editor" xsi:type="string">text</item>
                    <item name="filter" xsi:type="string">text</item>
                    <item name="dataType" xsi:type="string">text</item>
                </item>
            </argument>
        </column>

        <column name="order_date" class="Ebizcharge\Ebizcharge\Ui\Component\Listing\Column\SubscriptionOrders\DateTimeRenderer">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Date Created</item>
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
<!--                    <item name="dateFormat" xsi:type="string">yyyy-MM-dd</item>-->
                    <item name="sortable" xsi:type="boolean">true</item>
                    <item name="filter" xsi:type="string">dateRange</item>

                </item>
            </argument>
        </column>

        <column name="status" class="Ebizcharge\Ebizcharge\Ui\Component\Listing\Column\SubscriptionOrders\StatusColumnRenderer">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Ebizcharge\Ebizcharge\Model\Source\SubscriptionOrderStatuses</item>
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">select</item>
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="label" xsi:type="string" translate="true">Status</item>
                    <item name="editor" xsi:type="string">text</item>

                    <item name="dataType" xsi:type="string">select</item>
                    <item name="sortable" xsi:type="boolean">true</item>
                </item>
            </argument>
        </column>
        <column name="message">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Order History Info</item>
                    <item name="sortable" xsi:type="boolean">true</item>

                </item>
            </argument>
        </column>

    </columns>
</listing>
