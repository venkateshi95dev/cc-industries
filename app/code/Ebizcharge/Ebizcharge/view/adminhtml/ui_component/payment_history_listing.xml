<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">payment_history_listing.payment_history_listing</item>
            <item name="deps" xsi:type="string">payment_history_listing.payment_history_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">payment_history_grid_columns</item>
    </argument>


    <dataSource component="Magento_Ui/js/grid/provider" name="payment_history_listing_data_source">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Ebizcharge_Ebizcharge::menu_product_subscriptions_history</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="payment_history_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>


    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <exportButton name="export_button"/>

        <massaction name="listing_massaction">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="selectProvider" xsi:type="string">
                        payment_history_listing.payment_history_listing.payment_history_grid_columns.ids
                    </item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/tree-massactions</item>
                    <item name="indexField" xsi:type="string">entity_id</item>
                </item>
            </argument>
            <!-- Mass actions which you want to add in your grid-->
            <action name="send_email">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">send_email</item>
                        <item name="label" xsi:type="string" translate="true">Send Email</item>
                        <item name="url" xsi:type="url" path="ebizcharge_ebizcharge/recurrings/emailbulkaction">
                            <param name="actionName">send_email</param>
                        </item>
                        <item name="confirm" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Bulk Send Email</item>
                            <item name="message" xsi:type="string" translate="true">Are you sure you want to send Email?
                            </item>
                        </item>
                    </item>
                </argument>
            </action>

        </massaction>
        <filterSearch name="fulltext">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="placeholder" xsi:type="string">Search by Ref#, Customer Name, Email, Account Holder </item>
                </item>
            </argument>
        </filterSearch>
    </listingToolbar>



    <columns name="payment_history_grid_columns">

        <selectionsColumn name="ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">entity_id</item>
                    <item name="sorting" xsi:type="string">desc</item>
                    <item name="sortOrder" xsi:type="number">0</item>
                </item>
