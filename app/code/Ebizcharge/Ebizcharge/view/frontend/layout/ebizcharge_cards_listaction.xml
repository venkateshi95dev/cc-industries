/**
* Declares the block and sets the template for the Cards/ListAction controller.
*
*/
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="head.additional">
            <block
                ifconfig="payment/ebizcharge_ebizcharge/active" after="-"
                class="Magento\Framework\View\Element\Template"
                name="ebizcharge_ebizcharge.accounts.cards.list.css"
                template="Ebizcharge_Ebizcharge::html/accounts/accounts.phtml"
            />
        </referenceContainer>
        <referenceBlock name="customer_account_navigation">
            <action method="setActive">
                <argument name="path" xsi:type="string">ebizcharge/cards/listaction</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Ebizcharge\Ebizcharge\Block\Customer\Account\Cards"
                   ifconfig="payment/ebizcharge_ebizcharge/active" name="ebizcharge.cards.list"
                   cacheable="false" template="Ebizcharge_Ebizcharge::accounts/cards/cards_list.phtml"/>
        </referenceContainer>
    </body>
</page>
