<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="multishipping_checkout"/>
    <body>
        <referenceContainer name="head.additional">
            <block
                ifconfig="payment/ebizcharge_ebizcharge/active" after="-"
                class="Magento\Framework\View\Element\Template"
                name="ebizcharge_ebizcharge.accounts.multishipping.checkout.billing.css"
                template="Ebizcharge_Ebizcharge::html/accounts/accounts.phtml"
            />
        </referenceContainer>
        <!-- AVS CVV validation response modal -->
        <referenceContainer name="content">
            <block class="Ebizcharge\Ebizcharge\Block\Customer\Account\AddCard" name="ebizcharge.cards.validate"
                   ifconfig="payment/ebizcharge_ebizcharge/active"
                   template="Ebizcharge_Ebizcharge::accounts/cards/popup/validation-response.phtml"
                   after="-">
                <arguments>
                    <argument name="pciComplianceViewModel" xsi:type="object">Ebizcharge\Ebizcharge\ViewModel\PciCompliance</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
