<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <referenceBlock name="order_items">
            <action ifconfig="payment/ebizcharge_ebizcharge/active" method="setTemplate">
                <argument name="template" xsi:type="string">Ebizcharge_Ebizcharge::order/items.phtml</argument>
            </action>
        </referenceBlock>

        <!-- EbizCharge Surcharge -->
        <referenceContainer name="order_totals">
            <block class="Ebizcharge\Ebizcharge\Block\Sales\Order\SurchargeTotals"
                   ifconfig="payment/ebizcharge_ebizcharge/active"
                   name="ebiz_surcharge_order_view"/>
        </referenceContainer>
    </body>
</page>

