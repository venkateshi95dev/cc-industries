use Ebizcharge\Ebizcharge\Block\Customer\Account\Cards;
use Magento\Framework\Escaper;

/**
 * @var Cards $block
 * @var Escaper $escaper
 */

$paymentCards = $block->getPaymentMethods();
$achStatus = $block->getAchStatus();
$creditCardStatus = $block->getCreditCardsStatus();


if (!$creditCardStatus && !$achStatus) {
    ?>

    <div style="border: 1px solid #ff0000" class="message info empty margin-top"><span><?php /* @noEscape */ /* phpcs:ignore */ __('Credit card(s) & Bank Account(s) payments are disabled at Gateway. <br/>Kindly contact the webmaster.'); ?></span>
        <a href="<?= $escaper->escapeUrl($block->getUrl('customer/account/')) ?>"
           target="_parent"><?= /* @noEscape */ __("Go to Customer Account"); ?></a>
    </div>

<?php } else { ?>

    <div class="table-wrapper my-credit-cards">
        <div class="searchTabCustom">
            <ul class="items order-links">
                <li class="nav item current active-tab">
                    <span class="payment-tab"><?= /* @noEscape */ __('Stored Cards') ?></span>
                </li>
                <?php if ($achStatus) { ?>
                    <li class="nav item"
                        onclick="location.href = '<?= $escaper->escapeUrl($block->getStoredBankAccountsUrl()); ?>'">
                        <span class="payment-tab">Stored Bank Accounts</span>
                    </li>
                <?php } ?>
            </ul>
        </div>
        <br><br><br>
        <?php
        if ($creditCardStatus) {
            ?>
            <div class="actions-toolbar">
                <div class="primary">
                    <a href="<?= $escaper->escapeUrl($block->getAddCardUrl()) ?>">
                        <button type="button"
                                class="action primary"
                                title="<?= /* @noEscape */ __('Add New Card'); ?>">
                            <span><?= /* @noEscape */ __('Add New Credit Card'); ?></span>
                        </button>
                    </a>
                </div>
            </div>


