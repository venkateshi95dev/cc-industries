use Magento\Customer\Block\Address\Grid;
use Magento\Framework\Escaper;

/**
 * @var Grid $block
 * @var Escaper $escaper
 */

$customerAddressView = $block->getData('customer_address');
$subscriptionAddress = $block->getData('subscriptionAddress');
?>

<div class="block block-addresses-list">
    <div class="block-title">
        <strong><?= /* @noEscape */ __('Additional Address Entries') ?></strong>
    </div>
    <div class="block-content">
        <?php if ($_pAddsses = $block->getAdditionalAddresses()): ?>

            <div class="table-wrapper additional-addresses">
                <table class="data table table-additional-addresses-items history" id="additional-addresses-table">
                    <caption class="table-caption"><?= /* @noEscape */ __('Additional addresses') ?></caption>
                    <thead>
                    <tr>
                        <th scope="col" class="col firstname"><?= /* @noEscape */ __('First Name') ?></th>
                        <th scope="col" class="col lastname"><?= /* @noEscape */ __('Last Name') ?></th>
                        <th scope="col" class="col streetaddress"><?= /* @noEscape */ __('Street Address') ?></th>
                        <th scope="col" class="col city"><?= /* @noEscape */ __('City') ?></th>
                        <th scope="col" class="col country"><?= /* @noEscape */ __('Country') ?></th>
                        <th scope="col" class="col state"><?= /* @noEscape */ __('State') ?></th>
                        <th scope="col" class="col zip"><?= /* @noEscape */ __('Zip/Postal Code') ?></th>
                        <th scope="col" class="col phone"><?= /* @noEscape */ __('Phone') ?></th>
                        <th scope="col" class="col phone"><?= /* @noEscape */ __('Used in Subscription') ?></th>
                        <th scope="col" class="col actions"></th>
                    </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($_pAddsses as $address): ?>
                        <tr>
                            <td data-th="<?= /** @noEscape **/ __('First Name') ?>"
                                class="col firstname"><?= $escaper->escapeHtml($address->getFirstname()) ?></td>
                            <td data-th="<?= /** @noEscape **/ __('Last Name') ?>"
                                class="col lastname"><?= $escaper->escapeHtml($address->getLastname()) ?></td>
                            <td data-th="<?= /** @noEscape  */ __('Street Address') ?>"
                                class="col streetaddress">
                                <?= $escaper->escapeHtml($block->getStreetAddress($address)) ?>
                            </td>
                            <td data-th="<?= /** @noEscape */ __('City') ?>"
                                class="col city"><?= $escaper->escapeHtml($address->getCity()) ?></td>
                            <td data-th="<?= /** @noEscape **/ __('Country') ?>"
                                class="col country">
                                <?= $escaper->escapeHtml($block->getCountryByCode($address->getCountryId())) ?>
                            </td>
                            <td data-th="<?= /** @noEscape  */ __('State') ?>"
                                class="col state"><?= $escaper->escapeHtml($address->getRegion()->getRegion()) ?></td>
                            <td data-th="<?= /** @noEscape **/ __('Zip/Postal Code') ?>"
                                class="col zip"><?= $escaper->escapeHtml($address->getPostcode()) ?></td>
                            <td data-th="<?= /** @noEscape */ __('Phone') ?>"
                                class="col phone"><?= $escaper->escapeHtml($address->getTelephone()) ?></td>
                            <td data-th="<?= /** @noEscape  */ __('Used in Subscription') ?>"
                                class="col">
                                <?= $escaper->escapeHtml($subscriptionAddress->isShippingAddressUsedInSubscription(
                                    $address->getId()
                                )) ?>
                            </td>
                            <td data-th="<?= /** @noEscape **/ __('Actions') ?>" class="col actions">
                                <a class="action edit"
                                   href="<?= $escaper->escapeUrl($block->getUrl(
                                       'customer/address/edit',
                                       ['id' => $address->getId()]
                                   )) ?>">
                                    <span><?= /** @noEscape **/ __('Edit') ?></span>
                                </a>
                                <a class="action delete" href="#" role="delete-address"
                                   data-address="<?= $escaper->escapeHtmlAttr($address->getId()) ?>">
                                    <span><?= /** @noEscape **/ __('Delete') ?></span>
                                </a>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
            <?php if ($block->getChildHtml('pager')): ?>
                <div class="customer-addresses-toolbar toolbar bottom"><?= $block->getChildHtml('pager') ?></div>
            <?php endif ?>
        <?php else: ?>
            <p class="empty">
                <?= /** @noEscape **/ __('You have no other address entries in your address book.') ?>
            </p>
        <?php endif ?>
    </div>
</div>

<div class="actions-toolbar">
    <div class="primary">
        <button type="button" role="add-address" title="<?= /** @noEscape **/ __('Add New Address') ?>"
                class="action primary add">
            <span><?= /** @noEscape **/ __('Add New Address') ?></span>
        </button>
    </div>
    <div class="secondary">
        <a class="action back"
           href="<?= $escaper->escapeUrl($block->getUrl('customer/account')) ?>">
            <span><?= /** @noEscape **/ __('Back') ?></span>
        </a>
    </div>
</div>
<script type="text/x-magento-init">
    {
        ".page-main": {
            "address": {
                "deleteAddress": "td a[role='delete-address']",
                "deleteUrlPrefix": "<?= $escaper->escapeJs($escaper->escapeUrl($block->getDeleteUrl())) ?>id/",
                "addAddress": "button[role='add-address']",
                "addAddressLocation": "<?= $escaper->escapeJs($escaper->escapeUrl($block->getAddAddressUrl())) ?>"
            }
        }
    }
</script>
