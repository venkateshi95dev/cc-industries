use Ebizcharge\Ebizcharge\ViewModel\PciCompliance;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Model\Quote;

/** @var Template $block */
/** @var PciCompliance $pciViewModel */
$pciViewModel = $block->getData('pciComplianceViewModel');

/** @var Quote $quote */
$quote = $pciViewModel->getMultiShippingQuote();
$quoteData = [
    'total' => $quote->getTotals(),
    'items' => $pciViewModel->getQuoteItemsData($quote->getItems()),
    'email' => $quote->getCustomerEmail(),
    'isGuest' => (bool)$quote->getCustomerIsGuest(),
    'billingAddress' => $quote->getBillingAddress()->getData(),
    'shippingAddress' => $quote->getShippingAddress()->getData(),
    'shippingMethod' => $quote->getShippingAddress()->getShippingMethod(),
    'paymentMethod' => $quote->getPayment()->getMethod(),
    'quote' => [
        'tax_amount' => $quote->getShippingAddress()->getTaxAmount(),
        'grand_total' => $quote->getGrandTotal(),
        'subtotal_incl_tax' => $quote->getShippingAddress()->getSubtotalInclTax(),
        'shipping_incl_tax' => $quote->getShippingAddress()->getShippingInclTax(),
        'discount_amount' => $quote->getShippingAddress()->getDiscountAmount(),
    ]
];
?>

<script type="text/x-magento-init">
    {
        "*": {
            "ebizchargeMultiShippingPlaceOrder": {
                "payment": <?= /* @noEscape */ json_encode($block->getRequest()->getParam('payment')) ?>,
                "isRecurringEnabled": <?= /* @noEscape */ $pciViewModel->isRecurringEnabled() ?>,
                "quote": <?= /* @noEscape */ json_encode($quoteData) ?>
            }
        }
    }
</script>
