    <column xsi:type="bigint" name="destination_msg_id" padding="20" unsigned="false" nullable="false" identity="false" comment="Erp Msg id"/>
    <column xsi:type="text" name="additional_info" nullable="true"/>
    <column xsi:type="smallint" name="response_counter" padding="6" unsigned="false" nullable="false" identity="false" comment="response counter" default="0"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="msg_id"/>
    </constraint>
    <index referenceId="I95DEV_ERP_MESSAGEQUEUE_ERP_CODE_ENTITY_CODE_MAGENTO_ID" indexType="btree">
      <column name="erp_code"/>
      <column name="entity_code"/>
      <column name="magento_id"/>
    </index>
    <index referenceId="I95DEV_ERP_MESSAGEQUEUE_STATUS" indexType="btree">
      <column name="status"/>
    </index>
    <index referenceId="I95DEV_ERP_MESSAGEQUEUE_TARGET_ID" indexType="btree">
      <column name="target_id"/>
    </index>
    <index referenceId="I95DEV_ERP_MESSAGEQUEUE_ERROR_ID" indexType="btree">
      <column name="error_id"/>
    </index>
    <index referenceId="I95DEV_ERP_MESSAGEQUEUE_COUNTER" indexType="btree">
      <column name="counter"/>
    </index>
    <index referenceId="I95DEV_ERP_MESSAGEQUEUE_PARENT_MSG_ID" indexType="btree">
      <column name="parent_msg_id"/>
    </index>
    <index referenceId="I95DEV_ERP_MESSAGEQUEUE_DESTINATION_MSG_ID" indexType="btree">
      <column name="destination_msg_id"/>
    </index>
  </table>
  <table name="i95dev_magento_messagequeue" resource="default" engine="innodb" comment="Magento Messagequeue Details">
    <column xsi:type="bigint" name="msg_id" padding="20" unsigned="false" nullable="false" identity="true" comment="MSG ID"/>
