<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
  <table name="i95dev_customer_group" resource="default" engine="innodb" comment="i95dev_customer_group">
    <column xsi:type="bigint" name="id" padding="20" unsigned="false" nullable="false" identity="true" comment="id"/>
    <column xsi:type="varchar" name="target_group_id" nullable="true" length="255" comment="Target Group Id"/>
    <column xsi:type="varchar" name="pricelevel_id" nullable="true" length="255" comment="Price Level Id "/>
    <column xsi:type="smallint" name="customer_group_id" padding="6" unsigned="false" nullable="true" identity="false" comment="Customer Group Id"/>
    <column xsi:type="datetime" name="created_at" on_update="false" nullable="false" comment="Created Date"/>
    <column xsi:type="datetime" name="updated_at" on_update="false" nullable="false" comment="Updated Date"/>
    <column xsi:type="varchar" name="update_by" nullable="true" length="255" comment="Updated By"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="id"/>
    </constraint>
    <constraint xsi:type="unique" referenceId="I95DEV_CUSTOMER_GROUP_ID">
      <column name="id"/>
    </constraint>
  </table>
  <table name="i95dev_erp_data" resource="default" engine="innodb" comment="i95dev erp data">
    <column xsi:type="bigint" name="data_id" padding="20" unsigned="false" nullable="false" identity="true" comment="Data Id"/>
    <column xsi:type="bigint" name="msg_id" padding="20" unsigned="false" nullable="false" identity="false" comment="Message Id"/>
    <column xsi:type="mediumtext" name="data_string" nullable="true" comment="Data String"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="data_id"/>
    </constraint>
  </table>
  <table name="i95dev_entity" resource="default" engine="innodb" comment="Entity Details">
    <column xsi:type="int" name="entity_id" padding="11" unsigned="false" nullable="false" identity="true" comment="Entity ID"/>
    <column xsi:type="varchar" name="entity_name" nullable="false" length="255" comment="Entity Name"/>
    <column xsi:type="boolean" name="support_for_inbound" nullable="false" comment="Support For Inbound"/>
    <column xsi:type="boolean" name="support_for_outbound" nullable="false" comment="Support For Outbound"/>
    <column xsi:type="varchar" name="entity_code" nullable="false" length="255" comment="Entity Code"/>
    <column xsi:type="datetime" name="created_dt" on_update="false" nullable="false" comment="Creation Date"/>
    <column xsi:type="datetime" name="updated_dt" on_update="false" nullable="false" comment="Updated DateTime"/>
    <column xsi:type="decimal" name="sort_order" scale="1" precision="10" unsigned="false" nullable="false" default="0" onCreate="migrateDataFrom(sort_order)"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="entity_code"/>
    </constraint>
    <constraint xsi:type="unique" referenceId="I95DEV_ENTITY_ENTITY_ID">
      <column name="entity_id"/>
    </constraint>
  </table>
  <table name="i95dev_erp_messagequeue" resource="default" engine="innodb" comment="Erp Messagequeue Details">
    <column xsi:type="bigint" name="msg_id" padding="20" unsigned="false" nullable="false" identity="true" comment="MSG ID"/>
    <column xsi:type="varchar" name="erp_code" nullable="false" length="255" comment="Erp Code"/>
    <column xsi:type="varchar" name="entity_code" nullable="false" length="255" comment="Entity Type Code"/>
    <column xsi:type="datetime" name="created_dt" on_update="false" nullable="false" comment="Creation Date"/>
    <column xsi:type="datetime" name="updated_dt" on_update="false" nullable="false" comment="Updated DateTime"/>
    <column xsi:type="smallint" name="status" padding="6" unsigned="false" nullable="false" identity="false" comment="status"/>
    <column xsi:type="varchar" name="magento_id" nullable="false" length="255" comment="magento id"/>
    <column xsi:type="varchar" name="target_id" nullable="false" length="255" comment="Target_Id"/>
    <column xsi:type="bigint" name="error_id" padding="20" unsigned="false" nullable="false" identity="false" comment="error id"/>
    <column xsi:type="smallint" name="counter" padding="6" unsigned="false" nullable="false" identity="false" comment="counter"/>
