    <column xsi:type="smallint" name="status" padding="6" unsigned="false" nullable="false" identity="false" comment="status"/>
    <column xsi:type="varchar" name="magento_id" nullable="false" length="255" comment="magento id"/>
    <column xsi:type="varchar" name="target_id" nullable="false" length="255" comment="Target_Id"/>
    <column xsi:type="varchar" name="updated_by" nullable="false" length="255" comment="Updated By"/>
    <column xsi:type="bigint" name="error_id" padding="20" unsigned="false" nullable="false" identity="false" comment="Error Id"/>
    <column xsi:type="bigint" name="destination_msg_id" padding="20" unsigned="false" nullable="false" identity="false" comment="Erp Msg id"/>
    <column xsi:type="text" name="additional_info" nullable="true"/>
    <column xsi:type="smallint" name="counter" padding="6" unsigned="false" nullable="false" identity="false" comment="counter" default="0"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="msg_id"/>
    </constraint>
    <index referenceId="I95DEV_MAGENTO_MESSAGEQUEUE_ERP_CODE_ENTITY_CODE_MAGENTO_ID" indexType="btree">
      <column name="erp_code"/>
      <column name="entity_code"/>
      <column name="magento_id"/>
    </index>
  </table>
  <table name="i95dev_error_report" resource="default" engine="innodb" comment="i95dev_error_report">
    <column xsi:type="bigint" name="id" padding="20" unsigned="false" nullable="false" identity="true" comment="Id"/>
    <column xsi:type="varchar" name="msg" nullable="false" length="255" comment="msg"/>
    <constraint xsi:type="primary" referenceId="PRIMARY">
      <column name="id"/>
    </constraint>
  </table>
  <table name="i95dev_sales_flat_order" resource="default" engine="innodb" comment="i95dev_sales_flat_order">
    <column xsi:type="bigint" name="id" padding="20" unsigned="false" nullable="false" identity="true" comment="id"/>
    <column xsi:type="varchar" name="target_order_id" nullable="true" length="255" comment="Target Order Id"/>
    <column xsi:type="varchar" name="source_order_id" nullable="true" length="255" comment="Target Order Id "/>
