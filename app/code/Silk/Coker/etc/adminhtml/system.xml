<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="showpages" sortOrder="298">
            <label>ShowPages</label>
        </tab>
        <tab id="homefinderattr" sortOrder="297">
            <label>Silk Config</label>
        </tab>
        <section id="finderattribute" translate="label" type="text" sortOrder="500" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Config</label>
            <tab>homefinderattr</tab>
            <resource>Silk_Coker::system_config</resource>
            <group id="usual" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="search_no_results_block" translate="search no results block" type="text" sortOrder="1"  showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Search No Results Block</label>
                </field>
            </group>
            <group id="finder" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Finder</label>
                <field id="finder_no_results_block" translate="finder no results url" type="text" sortOrder="1"  showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>No Results Block</label>
                </field>
            </group>
            <group id="general" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Type of Tire</label>
                <field id="biaslookradial" translate="label comment" type="text" sortOrder="1"  showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Bias Look Radial</label>
                </field>
                <field id="biasply" translate="label comment" type="text" sortOrder="2"  showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Bias Ply</label>
                </field>
                <field id="radial" translate="label comment" type="text" sortOrder="2"  showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Radial</label>
                </field>
            </group>
            <group id="pop" translate="label" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="1">
               <label>Pop</label>
               <field id="is_active" translate="label" type="select" sortOrder="10" showInDefault="1">
                   <label>Display Pop</label>
                   <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
               </field>
            </group>
            <group id="header_code" translate="label" sortOrder="7" showInDefault="1" showInWebsite="1" showInStore="1">
               <label>Http Code</label>
               <field id="code" translate="code" type="text" sortOrder="2"  showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                  <label>Response Code</label>
               </field>
            </group>
            <group id="hotjar" translate="label" sortOrder="8" showInDefault="1" showInWebsite="1" showInStore="1">
               <label>Hotjar</label>
               <field id="is_active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                   <label>Display Hotjar</label>
                   <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
               </field>
            </group>
            <group id="ordercancel" translate="label" sortOrder="9" showInDefault="1" showInWebsite="1" showInStore="1">
               <label>Order Email</label>
                <field id="email" type="textarea" sortOrder="2"  showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                  <label>Order Cancel Email</label>
               </field>
            </group>
            <group id="newsletter" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
               <label>Newsletter</label>
               <field id="is_active" translate="label" type="select" sortOrder="10" showInDefault="1">
                   <label>Display Newsletter</label>
                   <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
               </field>
            </group>
            <group id="cartreport" translate="label" sortOrder="17" showInDefault="1" showInWebsite="1" showInStore="1">
               <label>Abandoned Cart Report</label>
               <field id="email" translate="code" type="textarea" sortOrder="1"  showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                  <label>Email</label>
               </field>
               <field id="emailid" translate="code" type="text" sortOrder="1"  showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                  <label>Email Template Id</label>
               </field>
            </group>
            <group id="checkout" translate="label" sortOrder="17" showInDefault="1" showInWebsite="1" showInStore="1">
               <label>International Orders Message</label>
               <field id="message" translate="code" type="textarea" sortOrder="1"  showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                  <label>Message</label>
               </field>
               <field id="shipping_address_notice" translate="code" type="textarea" sortOrder="1"  showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                  <label>Shipping Address Notice</label>
               </field>
            </group>
        </section>
        <section id="showpagesconfig" translate="label" type="text" sortOrder="500" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>showpages Config</label>
            <tab>showpages</tab>
            <resource>Silk_Coker::system_config</resource>
            <group id="general" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="page_title" translate="label comment" type="text" sortOrder="2"  showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Page Title</label>
                </field>
            </group>
        </section>
        <section id="product_modal" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Product Page Custom Settings</label>
            <tab>silk</tab>
            <resource>Silk_Core::configuration</resource>
            <group id="condition" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product Call For Setting</label>
                <field id="is_active" translate="label" type="select" sortOrder="10" showInDefault="1">
                   <label>Enable call for popup</label>
                   <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
               </field>
                <field id="category" translate="label" sortOrder="220" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Hide popup for special categories</label>
                    <frontend_model>Silk\Coker\Block\Adminhtml\Form\Field\Category</frontend_model>
                    <backend_model>Silk\Coker\Model\Adminhtml\System\Config\Category</backend_model>
                    <config_path>modal/condition/category</config_path>
                </field>
            </group>
            <group id="product" translate="label" type="text" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>ETP/EWP Displaying Setting</label>
                <field id="etp" translate="label" type="textarea" sortOrder="230" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>ETP</label>
                </field>
                <field id="ewp" translate="label" type="textarea" sortOrder="240" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>EWP</label>
                </field>
                <field id="ewp_allowed_attribute_set_name" translate="label" type="textarea" sortOrder="250" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>EWP Allowed Attribute Set Name</label>
                </field>
            </group>
        </section>

         <section id="google" translate="label" type="text" sortOrder="340" showInDefault="1" showInWebsite="1" showInStore="1">
            <tab>sales</tab>
            <resource>Magento_GoogleAnalytics::google</resource>
            <group id="analyticsga4" translate="label" type="text" sortOrder="210" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Google Analytics (GA4)</label>
                <field id="ga4code" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>GA4 Code</label>
                </field>
            </group>
        </section>

        <section id="general" translate="label" type="text" sortOrder="400" showInDefault="1"
            showInWebsite="1" showInStore="1">
            <group id="store_information" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                 <field id="google_map_key" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1">
                    <label>Google Map API Key</label>
                </field>
                <field id="map_lat" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1">
                    <label>Google Map Position (Lat)</label>
                </field>
                <field id="map_lng" translate="label" type="text" sortOrder="120" showInDefault="1" showInWebsite="1">
                    <label>Google Map Position (Lng)</label>
                </field>
            </group>
         </section>

      </system>
</config>
