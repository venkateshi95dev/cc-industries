<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="silk_payment" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Silk Payment</label>
                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="hostname" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>host name</label>
                </field>
                <field id="apiurl" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>request url</label>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="45" showInDefault="1" showInWebsite="1" showInStore="0">
                  <label>Sort Order</label>
               </field>
                <group id="credentials" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Credentials Config</label>
                    <field id="apikey" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>apikey</label>
                    </field>
                    <field id="apisecret" translate="label" type="text" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>use apisecret for authorize</label>
                    </field>
                </group>
                <group id="gateway_config" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Gateway Config</label>
                    <field id="gateway" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>gateway</label>
                    </field>
                    <field id="apikey" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>apikey</label>
                    </field>
                    <field id="apisecret" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>use apiSecret for hash hmac</label>
                    </field>
                    <field id="token" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>authToken</label>
                    </field>
                    <field id="transarmortoken" translate="label" type="text" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>transarmorToken</label>
                    </field>
                    <field id="zeroDollarAuth" translate="label" type="select" sortOrder="7" showInDefault="1" showInWebsite="1" showInStore="0">
                          <label>zeroDollarAuth</label>
                          <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                </group>

            </group>
        </section>
    </system>
</config>