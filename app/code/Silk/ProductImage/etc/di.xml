<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Silk\ProductImage\Api\Data\DocumentSearchResultsInterface"
                type="Silk\ProductImage\Model\DocumentSearchResults" />
    <preference for="Silk\ProductImage\Api\Data\DocumentInterface" type="Silk\ProductImage\Model\Document" />
    <preference for="Silk\ProductImage\Api\DocumentRepositoryInterface" type="Silk\ProductImage\Model\DocumentRepository" />
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="img_document_listing_data_source" xsi:type="string">Silk\ProductImage\Model\ResourceModel\Document\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="Silk\ProductImage\Model\ResourceModel\Document\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">img_document</argument>
            <argument name="eventPrefix" xsi:type="string">img_document_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">document_grid_collection</argument>
            <argument name="resourceModel" xsi:type="string">Silk\ProductImage\Model\ResourceModel\Document</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\EntityManager\MetadataPool">
        <arguments>
            <argument name="metadata" xsi:type="array">
                <item name="Silk\ProductImage\Api\Data\DocumentInterface" xsi:type="array">
                    <item name="entityTableName" xsi:type="string">img_document</item>
                    <item name="identifierField" xsi:type="string">entity_id</item>
                </item>
            </argument>
        </arguments>
    </type>

    <virtualType name="Silk\ProductImage\Model\Api\SearchCriteria\CollectionProcessor\DocumentFilterProcessor" type="Magento\Framework\Api\SearchCriteria\CollectionProcessor\FilterProcessor">
        <arguments>
            <argument name="customFilters" xsi:type="array">
                <item name="store_id" xsi:type="object">Silk\ProductImage\Model\Api\SearchCriteria\CollectionProcessor\FilterProcessor\DocumentFilter</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Silk\ProductImage\Model\Api\SearchCriteria\DocumentCollectionProcessor" type="Magento\Framework\Api\SearchCriteria\CollectionProcessor">
        <arguments>
            <argument name="processors" xsi:type="array">
                <item name="filters" xsi:type="object">Silk\ProductImage\Model\Api\SearchCriteria\CollectionProcessor\DocumentFilterProcessor</item>
                <item name="sorting" xsi:type="object">Magento\Framework\Api\SearchCriteria\CollectionProcessor\SortingProcessor</item>
                <item name="pagination" xsi:type="object">Magento\Framework\Api\SearchCriteria\CollectionProcessor\PaginationProcessor</item>
            </argument>
        </arguments>
    </virtualType>
</config>