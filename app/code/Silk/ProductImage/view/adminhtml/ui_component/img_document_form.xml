<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">img_document_form.document_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Document Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Silk\ProductImage\Block\Adminhtml\Document\Edit\SaveButton"/>
            <button name="delete" class="Silk\ProductImage\Block\Adminhtml\Document\Edit\DeleteButton"/>
            <button name="back" class="Silk\ProductImage\Block\Adminhtml\Document\Edit\BackButton"/>
        </buttons>
        <namespace>img_document_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>img_document_form.document_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="document_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="document/documentlist/save"/>
        </settings>
        <dataProvider class="Silk\ProductImage\Model\Document\DataProvider" name="document_form_data_source">
            <settings>
                <requestFieldName>document_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label/>
        </settings>
        <field name="document_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">document</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>document_id</dataScope>
            </settings>
        </field>
        <field name="is_active" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">document</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enable Document</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="for_base_image" sortOrder="15" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">document</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">For Base Image</label>
                <dataScope>for_base_image</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="title" sortOrder="20" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">document</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Document Title</label>
                <dataScope>title</dataScope>
            </settings>
        </field>
        <field name="file" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="required" xsi:type="boolean">true</item>
                    <item name="label" xsi:type="string">File</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="notice" xsi:type="string" translate="true">Allowed file types: png, gif, jpg, jpeg</item>
                    <item name="formElement" xsi:type="string">fileUploader</item>
                    <item name="uploaderConfig" xsi:type="array">
                        <item name="url" xsi:type="url" path="document/documentlist/upload"/>
                    </item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
            </settings>
        </field>
    </fieldset>
    <fieldset name="assign_products">
        <settings>
            <collapsible>false</collapsible>
            <label translate="true">Products in Documents</label>
        </settings>
        <container name="assign_products_container">
            <htmlContent name="html_content">
                <block name="assignProducts" class="Silk\ProductImage\Block\Adminhtml\AssignProducts"/>
            </htmlContent>
        </container>
    </fieldset>
</form>
